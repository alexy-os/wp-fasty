{
  "id": "press",
  "label": "Magazine",
  "description": "A magazine front: intro, latest stories, topics and a call to action.",
  "landing": "tools/builder/landings/press.json",
  "layout": {
    "source": "ui8kit",
    "blocks": [
      {
        "id": "intro",
        "block": "intro-simple",
        "variant": "start",
        "props": {
          "badge": "Journal",
          "title": "The journal",
          "description": "Notes on design, engineering and the work in between.",
          "actionLabel": "Read the latest",
          "actionHref": "{posts}"
        }
      },
      {
        "id": "latest",
        "block": "stories-simple",
        "variant": "cols3",
        "props": {
          "title": "Latest stories",
          "description": "Fresh writing from the team.",
          "stories": [
            {
              "id": "story-1",
              "title": "Designing with tokens",
              "description": "How one set of variables carries a whole site.",
              "href": "{posts}"
            },
            {
              "id": "story-2",
              "title": "Shipping small",
              "description": "Short cycles, fewer surprises.",
              "href": "{posts}"
            },
            {
              "id": "story-3",
              "title": "Reading the logs",
              "description": "What production tells us when we listen.",
              "href": "{posts}"
            }
          ]
        }
      },
      {
        "id": "topics",
        "block": "topics-simple",
        "variant": "cards3",
        "props": {
          "title": "Topics",
          "description": "Pick a thread and follow it.",
          "items": [
            {
              "id": "topic-1",
              "label": "Design",
              "title": "Design notes",
              "description": "Type, colour and layout.",
              "href": "{category:design}"
            },
            {
              "id": "topic-2",
              "label": "Engineering",
              "title": "Engineering",
              "description": "Build, test and ship.",
              "href": "{category:engineering}"
            },
            {
              "id": "topic-3",
              "label": "Process",
              "title": "Process",
              "description": "How the work gets done.",
              "href": "{posts}"
            }
          ]
        }
      },
      {
        "id": "cta",
        "block": "cta-simple",
        "variant": "center",
        "props": {
          "title": "Never miss a story",
          "description": "One email a week with the best of the journal.",
          "actionLabel": "Subscribe",
          "actionHref": "{page:subscribe}"
        }
      }
    ]
  }
}
