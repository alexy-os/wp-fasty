{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "svelte"
    ],
    "baseUrl": ".",
    "paths": {
      "svelte": [
        "./node_modules/svelte/types/index.d.ts"
      ],
      "svelte/*": [
        "./node_modules/svelte/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "../../../modules/builder-agent/editor/**/*.ts",
    "../../../modules/builder-agent/editor/**/*.svelte"
  ]
}
