{* WP FastY kit — Badge: composition over UI8Kit 3 Text <span> + the codegen-x badge recipe (presets/components/badge.json), as kit-compose Badge. *}
{parameters
  string $variant = '',
  string $size = '',
  string $class = '',
  array $attrs = [],
  string $children = '',
}
{include 'text/Text.latte', tag: 'span', class: kit('badge', ['variant' => $variant, 'size' => $size], $class), attrs: $attrs, children: $children}
