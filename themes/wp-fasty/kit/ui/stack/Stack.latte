{* WP FastY kit — Stack: composition over UI8Kit 3 Box + the codegen-x stack recipe (presets/components/stack.json): gap, align, justify. *}
{parameters
  string $class = '',
  string $tag = '',
  string $gap = '',
  string $align = '',
  string $justify = '',
  array $attrs = [],
  string $children = '',
}
{include 'box/Box.latte', tag: in_array($tag, ['div', 'ul', 'ol'], true) ? $tag : 'div', class: kit('stack', ['gap' => $gap, 'align' => $align, 'justify' => $justify], $class), attrs: $attrs, children: $children}
