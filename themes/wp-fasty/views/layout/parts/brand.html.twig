{#
 # Site brand — logo image or title text. Twig twin of brand.latte.
 #}
{% set c_ui1 %}
	{% if site.logo.url ?? false %}
		{% include 'image/Image.html.twig' with {
			src: site.logo.url,
			alt: site.logo.alt ?? site.title,
			width: (site.logo.width ?? '') ~ '',
			height: (site.logo.height ?? '') ~ '',
			class: kit('image', {}, 'h-8 w-auto'),
			loading: 'eager',
			decoding: 'async'
		} %}
	{% else %}
		{{ site.title }}
	{% endif %}
{% endset %}{% include 'link/Link.html.twig' with {'href': site.url|default(''), 'class': kit('link', {'variant': 'nav', 'size': 'md'}, 'tracking-tight'), 'children': c_ui1, 'attrs': {}} only %}
