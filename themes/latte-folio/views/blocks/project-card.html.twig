{#
 # Folio — project card (Twig twin of project-card.latte). Params: project (post view-model), labels
 #}
<article class="group flex flex-col gap-4">
	<a href="{{ project.url|safe_url }}" class="block overflow-hidden rounded-xl border border-border bg-card no-underline" aria-label="{{ project.title }}">
		{% if project.featuredImage.url ?? false %}
			{% include 'image/Image.html.twig' with { src: project.featuredImage.url, alt: project.featuredImage.alt ?? '', sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw', class: kit('image', {}, 'aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105'), loading: 'lazy', srcSet: project.featuredImage.srcset ?? '', decoding: 'async' } %}
		{% else %}
			<div class="flex aspect-[4/3] items-center justify-center text-muted-foreground">{{ icon('image', 'size-8') }}</div>
		{% endif %}
	</a>
	<div class="flex items-start justify-between gap-4">
		<div class="flex flex-col gap-2">
			<h3 class="text-lg font-semibold leading-tight">
				<a href="{{ project.url|safe_url }}" class="text-foreground no-underline hover:text-primary">{{ project.title }}</a>
			</h3>
			{% if project.types ?? false %}
				<div class="flex flex-wrap gap-2">
					{% for type in project.types %}
						{% set typeName %}{{ type.name }}{% endset %}{% include 'badge/Badge.html.twig' with { variant: 'secondary', children: typeName } %}
					{% endfor %}
				</div>
			{% endif %}
		</div>
		{% if project.project.year.value ?? false %}
			<span class="text-sm text-muted-foreground">{{ project.project.year.value }}</span>
		{% endif %}
	</div>
</article>
