{** Latte Folio — project case study. *}
{if $page}
{capture $c_ui17}
	{capture $c_ui13}
		{capture $c_ui1}{icon('arrow-left')}{$labels['all_work']}{/capture}{include 'link/Link.latte', href: ((($work['url'])|checkUrl)) ?? '', class: 'mb-8 inline-flex items-center gap-2 text-sm text-muted-foreground no-underline hover:text-foreground', children: (string) $c_ui1, attrs: []}
		{capture $c_ui12}
			{capture $c_ui5}
				{if !empty($page['types'])}
					{capture $c_ui2}
						{foreach $page['types'] as $type}
							{capture $typeName}{$type['name']}{/capture}{include 'badge/Badge.latte', variant: 'secondary', children: (string) $typeName}
						{/foreach}
					{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-wrap gap-2', children: (string) $c_ui2, attrs: []}
				{/if}
				{capture $c_ui3}{$page['title']}{/capture}{include 'text/Text.latte', tag: 'h1', class: 'text-4xl font-bold leading-tight tracking-tight md:text-5xl', children: (string) $c_ui3, attrs: []}
				{if !empty($page['excerpt'])}{capture $c_ui4}{$page['excerpt']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-lg text-muted-foreground', children: (string) $c_ui4, attrs: []}{/if}
			{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-4', children: (string) $c_ui5, attrs: []}
			{if !empty($page['project'])}
				{capture $c_ui11}
					{foreach $page['project'] as $key => $meta}
						{if $key !== 'url'}
							{capture $c_ui8}
								{capture $c_ui6}{$meta['label']}{/capture}{include 'box/Box.latte', tag: 'dt', class: 'text-xs uppercase tracking-wide text-muted-foreground', children: (string) $c_ui6, attrs: []}
								{capture $c_ui7}{$meta['value']}{/capture}{include 'box/Box.latte', tag: 'dd', class: 'font-medium', children: (string) $c_ui7, attrs: []}
							{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-2', children: (string) $c_ui8, attrs: []}
						{/if}
					{/foreach}
					{if !empty($page['project']['url']['value'])}
						{capture $c_ui10}
							{capture $c_ui9}{$labels['visit_site']}{icon('external-link')}{/capture}{include 'link/Link.latte', href: ((($page['project']['url']['value'])|checkUrl)) ?? '', class: 'inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground no-underline', children: (string) $c_ui9, attrs: ['rel' => 'noopener', 'target' => '_blank']}
						{/capture}{include 'box/Box.latte', tag: 'div', class: 'col-span-2', children: (string) $c_ui10, attrs: []}
					{/if}
				{/capture}{include 'box/Box.latte', tag: 'dl', class: 'grid grid-cols-2 gap-6 self-end rounded-xl border border-border bg-card p-6', children: (string) $c_ui11, attrs: []}
			{/if}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'grid gap-8 lg:grid-cols-[2fr_1fr]', children: (string) $c_ui12, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'header', class: 'container mx-auto px-4 pb-8 pt-16 md:px-6', children: (string) $c_ui13, attrs: []}

	{if !empty($page['featuredImage']['url'])}
		{capture $c_ui14}
			{include 'image/Image.latte', src: $page['featuredImage']['url'], alt: $page['featuredImage']['alt'] ?? '', sizes: '100vw', class: kit('image', [], 'aspect-[16/9] w-full rounded-2xl border border-border object-cover'), loading: 'eager', srcSet: $page['featuredImage']['srcset'] ?? '', decoding: 'async'}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'container mx-auto px-4 md:px-6', children: (string) $c_ui14, attrs: []}
	{/if}

	{capture $c_ui16}
		{capture $c_ui15}{$page['content']|noescape}{/capture}{include 'box/Box.latte', tag: 'div', class: 'prose max-w-none', children: (string) $c_ui15, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'container mx-auto max-w-3xl px-4 py-16 md:px-6', children: (string) $c_ui16, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'article', class: ($page['post_class'] ?? ''), children: (string) $c_ui17, attrs: []}

{if !empty($next_project)}
	{capture $c_ui23}
		{capture $c_ui22}
			{capture $c_ui20}
				{capture $c_ui18}{$labels['next_project']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm text-muted-foreground', children: (string) $c_ui18, attrs: []}
				{capture $c_ui19}{$next_project['title']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-2xl font-semibold text-foreground', children: (string) $c_ui19, attrs: []}
			{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-2', children: (string) $c_ui20, attrs: []}
			{capture $c_ui21}{icon('arrow-right', 'size-8')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-primary', children: (string) $c_ui21, attrs: []}
		{/capture}{include 'link/Link.latte', href: ((($next_project['url'])|checkUrl)) ?? '', class: 'group flex items-center justify-between gap-6 rounded-2xl border border-border bg-card p-8 no-underline hover:border-primary', children: (string) $c_ui22, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 pb-16 md:px-6', children: (string) $c_ui23, attrs: []}
{/if}
{/if}
