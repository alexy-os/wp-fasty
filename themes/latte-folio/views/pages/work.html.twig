{# Latte Folio — work archive with type filter (Twig twin of work.latte). #}
{% set c_ui6 %}
	{% set c_ui1 %}{{ archive.title }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h1', 'class': 'text-4xl font-bold tracking-tight md:text-5xl', 'children': c_ui1, 'attrs': {}} only %}
	{% if archive.description ?? false %}
		{% set c_ui2 %}{{ archive.description|raw }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mt-4 max-w-2xl text-muted-foreground', 'children': c_ui2, 'attrs': {}} only %}
	{% endif %}
	{% if work.types ?? false %}
		{% set c_ui5 %}
			{% set c_ui3 %}{{ labels.all_work }}{% endset %}{% include 'link/Link.html.twig' with {'href': work.url|default(''), 'class': kit('button', {'variant': (work.current is same as('')) ? 'default' : 'outline'}), 'children': c_ui3, 'attrs': {'aria-current': ((work.current is same as(''))) ? 'page' : null}} only %}
			{% for type in work.types %}
				{% set c_ui4 %}{{ type.name }}{% endset %}{% include 'link/Link.html.twig' with {'href': type.url|default(''), 'class': kit('button', {'variant': (work.current is same as(type.slug)) ? 'default' : 'outline'}), 'children': c_ui4, 'attrs': {'aria-current': ((work.current is same as(type.slug))) ? 'page' : null}} only %}
			{% endfor %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'nav', 'class': 'mt-8 flex flex-wrap gap-2', 'children': c_ui5, 'attrs': {'aria-label': (labels.all_work)}} only %}
	{% endif %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 pb-8 pt-16 md:px-6', 'children': c_ui6, 'attrs': {}} only %}

{% set c_ui9 %}
	{% if not posts %}
		{% set c_ui7 %}{{ labels.no_projects }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'py-16 text-center text-muted-foreground', 'children': c_ui7, 'attrs': {}} only %}
	{% else %}
		{% set c_ui8 %}
			{% for project in posts %}
				{% include 'blocks/project-card.html.twig' with { project: project, labels: labels, headingTag: 'h2' } %}
			{% endfor %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid gap-8 md:grid-cols-2 lg:grid-cols-3', 'children': c_ui8, 'attrs': {}} only %}
	{% endif %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 py-8 md:px-6', 'children': c_ui9, 'attrs': {}} only %}
