{** Latte Folio — home: hero, selected work, services, contact CTA. *}
{capture $c_ui8}
	{capture $c_ui7}
		{capture $c_ui1}
			{include 'text/Text.latte', tag: 'span', class: 'size-2 rounded-full bg-primary', attrs: []}{$site['description']}
		{/capture}{include 'text/Text.latte', tag: 'span', class: kit('badge', ['variant' => 'outline', 'size' => 'lg'], 'w-fit gap-2'), children: (string) $c_ui1, attrs: []}
		{capture $c_ui2}
			{if !empty($page['title'])}{$page['title']}{else}{$site['title']}{/if}
		{/capture}{include 'text/Text.latte', tag: 'h1', class: 'text-4xl font-bold leading-tight tracking-tight md:text-6xl', children: (string) $c_ui2, attrs: []}
		{if !empty($page['excerpt'])}
			{capture $c_ui3}{$page['excerpt']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'max-w-2xl text-lg text-muted-foreground', children: (string) $c_ui3, attrs: []}
		{/if}
		{capture $c_ui6}
			{capture $c_ui4}{$labels['selected_work']}{icon('arrow-right')}{/capture}{include 'link/Link.latte', href: '#work', class: kit('button', ['size' => 'lg'], 'gap-2'), children: (string) $c_ui4, attrs: []}
			{capture $c_ui5}{icon('mail')}{$labels['contact']}{/capture}{include 'link/Link.latte', href: $contact_url ?? '', class: kit('button', ['variant' => 'outline', 'size' => 'lg'], 'gap-2'), children: (string) $c_ui5, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-wrap gap-4', children: (string) $c_ui6, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex max-w-4xl flex-col gap-6', children: (string) $c_ui7, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 pb-16 pt-24 md:px-6 md:pt-32', children: (string) $c_ui8, attrs: []}

{if !empty($projects)}
	{capture $c_ui13}
		{capture $c_ui11}
			{capture $c_ui9}{$labels['selected_work']}{/capture}{include 'text/Text.latte', tag: 'h2', class: 'text-2xl font-semibold tracking-tight md:text-3xl', children: (string) $c_ui9, attrs: []}
			{capture $c_ui10}{$labels['all_work']}{icon('arrow-up-right')}{/capture}{include 'link/Link.latte', href: $work['url'] ?? '', class: kit('link', ['size' => 'sm']), children: (string) $c_ui10, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'mb-8 flex items-end justify-between gap-4', children: (string) $c_ui11, attrs: []}
		{capture $c_ui12}
			{foreach $projects as $project}
				{include 'blocks/project-card.latte', project: $project, labels: $labels}
			{/foreach}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'grid gap-8 md:grid-cols-2 lg:grid-cols-3', children: (string) $c_ui12, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 py-16 md:px-6', children: (string) $c_ui13, attrs: ['id' => 'work']}
{/if}

{if !empty($services)}
	{capture $c_ui19}
		{capture $c_ui18}
			{foreach $services as $service}
				{capture $svc}
					{capture $c_ui17}
						{capture $c_ui14}{icon($service['icon'], 'size-6')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'inline-flex size-12 items-center justify-center rounded-lg bg-primary text-primary-foreground', children: (string) $c_ui14, attrs: []}
						{capture $c_ui15}{$service['title']}{/capture}{include 'text/Text.latte', tag: 'h3', class: 'text-lg font-semibold', children: (string) $c_ui15, attrs: []}
						{capture $c_ui16}{$service['text']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-sm text-muted-foreground', children: (string) $c_ui16, attrs: []}
					{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-4 p-6', children: (string) $c_ui17, attrs: []}
				{/capture}
				{include 'card/Card.latte', children: (string) $svc}
			{/foreach}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'grid gap-6 md:grid-cols-3', children: (string) $c_ui18, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 py-16 md:px-6', children: (string) $c_ui19, attrs: []}
{/if}

{if !empty($page['content'])}
	{capture $c_ui21}
		{capture $c_ui20}{$page['content']|noescape}{/capture}{include 'box/Box.latte', tag: 'div', class: 'prose max-w-none', children: (string) $c_ui20, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto max-w-3xl px-4 py-16 md:px-6', children: (string) $c_ui21, attrs: []}
{/if}

{capture $c_ui25}
	{capture $c_ui24}
		{capture $c_ui22}{$labels['contact']}?{/capture}{include 'text/Text.latte', tag: 'h2', class: 'text-2xl font-semibold tracking-tight md:text-3xl', children: (string) $c_ui22, attrs: []}
		{capture $c_ui23}{icon('send')}{$labels['contact']}{/capture}{include 'link/Link.latte', href: $contact_url ?? '', class: kit('button', ['size' => 'lg'], 'gap-2'), children: (string) $c_ui23, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col items-start gap-6 rounded-2xl border border-border bg-card p-8 md:flex-row md:items-center md:justify-between md:p-12', children: (string) $c_ui24, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 py-16 md:px-6', children: (string) $c_ui25, attrs: []}
