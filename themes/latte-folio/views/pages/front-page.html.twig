{# Latte Folio — home: hero, selected work, services, contact CTA (Twig twin of front-page.latte). #}
{% set c_ui8 %}
	{% set c_ui7 %}
		{% set c_ui1 %}
			{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'size-2 rounded-full bg-primary', 'attrs': {}} only %}{{ site.description }}
		{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex w-fit items-center gap-2 rounded-full border border-border px-4 py-2 text-sm text-muted-foreground', 'children': c_ui1, 'attrs': {}} only %}
		{% set c_ui2 %}
			{% if page.title ?? false %}{{ page.title }}{% else %}{{ site.title }}{% endif %}
		{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h1', 'class': 'text-4xl font-bold leading-tight tracking-tight md:text-6xl', 'children': c_ui2, 'attrs': {}} only %}
		{% if page.excerpt ?? false %}
			{% set c_ui3 %}{{ page.excerpt }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'max-w-2xl text-lg text-muted-foreground', 'children': c_ui3, 'attrs': {}} only %}
		{% endif %}
		{% set c_ui6 %}
			{% set c_ui4 %}{{ labels.selected_work }}{{ icon('arrow-right') }}{% endset %}{% include 'link/Link.html.twig' with {'href': '#work', 'class': 'inline-flex h-12 items-center gap-2 rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90', 'children': c_ui4, 'attrs': {}} only %}
			{% set c_ui5 %}{{ icon('mail') }}{{ labels.contact }}{% endset %}{% include 'link/Link.html.twig' with {'href': contact_url|default(''), 'class': 'inline-flex h-12 items-center gap-2 rounded-md border border-border px-6 text-sm font-semibold text-foreground no-underline hover:bg-accent', 'children': c_ui5, 'attrs': {}} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-wrap gap-4', 'children': c_ui6, 'attrs': {}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex max-w-4xl flex-col gap-6', 'children': c_ui7, 'attrs': {}} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 pb-16 pt-24 md:px-6 md:pt-32', 'children': c_ui8, 'attrs': {}} only %}

{% if projects ?? false %}
	{% set c_ui13 %}
		{% set c_ui11 %}
			{% set c_ui9 %}{{ labels.selected_work }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'text-2xl font-semibold tracking-tight md:text-3xl', 'children': c_ui9, 'attrs': {}} only %}
			{% set c_ui10 %}{{ labels.all_work }}{{ icon('arrow-up-right') }}{% endset %}{% include 'link/Link.html.twig' with {'href': work.url|default(''), 'class': 'inline-flex items-center gap-2 text-sm font-medium text-primary no-underline', 'children': c_ui10, 'attrs': {}} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mb-8 flex items-end justify-between gap-4', 'children': c_ui11, 'attrs': {}} only %}
		{% set c_ui12 %}
			{% for project in projects %}
				{% include 'blocks/project-card.html.twig' with { project: project, labels: labels } %}
			{% endfor %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid gap-8 md:grid-cols-2 lg:grid-cols-3', 'children': c_ui12, 'attrs': {}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 py-16 md:px-6', 'children': c_ui13, 'attrs': {'id': 'work'}} only %}
{% endif %}

{% if services ?? false %}
	{% set c_ui19 %}
		{% set c_ui18 %}
			{% for service in services %}
				{% set svc %}
					{% set c_ui17 %}
						{% set c_ui14 %}{{ icon(service.icon, 'size-6') }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex size-12 items-center justify-center rounded-lg bg-primary text-primary-foreground', 'children': c_ui14, 'attrs': {}} only %}
						{% set c_ui15 %}{{ service.title }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h3', 'class': 'text-lg font-semibold', 'children': c_ui15, 'attrs': {}} only %}
						{% set c_ui16 %}{{ service.text }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': c_ui16, 'attrs': {}} only %}
					{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col gap-4 p-6', 'children': c_ui17, 'attrs': {}} only %}
				{% endset %}
				{% include 'card/Card.html.twig' with { class: 'border-border', children: svc } %}
			{% endfor %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid gap-6 md:grid-cols-3', 'children': c_ui18, 'attrs': {}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 py-16 md:px-6', 'children': c_ui19, 'attrs': {}} only %}
{% endif %}

{% if page.content ?? false %}
	{% set c_ui21 %}
		{% set c_ui20 %}{{ page.content|raw }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'prose max-w-none', 'children': c_ui20, 'attrs': {}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto max-w-3xl px-4 py-16 md:px-6', 'children': c_ui21, 'attrs': {}} only %}
{% endif %}

{% set c_ui25 %}
	{% set c_ui24 %}
		{% set c_ui22 %}{{ labels.contact }}?{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'text-2xl font-semibold tracking-tight md:text-3xl', 'children': c_ui22, 'attrs': {}} only %}
		{% set c_ui23 %}{{ icon('send') }}{{ labels.contact }}{% endset %}{% include 'link/Link.html.twig' with {'href': contact_url|default(''), 'class': 'inline-flex h-12 items-center gap-2 rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90', 'children': c_ui23, 'attrs': {}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col items-start gap-6 rounded-2xl border border-border bg-card p-8 md:flex-row md:items-center md:justify-between md:p-12', 'children': c_ui24, 'attrs': {}} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 py-16 md:px-6', 'children': c_ui25, 'attrs': {}} only %}
