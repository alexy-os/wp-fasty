{
  "name": "alexy-os/latte",
  "description": "Latte — clean WP FastY theme with UI8Kit 3 primitives",
  "type": "wordpress-theme",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "alexy-os"
    }
  ],
  "require": {
    "php": ">=8.2",
    "latte/latte": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "WPFasty\\": "classes/",
      "UI8Kit\\Latte\\": "ui8kit/runtime/",
      "UI8Kit\\Twig\\": "twig/ui8kit/runtime/",
      "CodegenX\\Compose\\Latte\\": "ui8kit/compose/",
      "CodegenX\\Compose\\Twig\\": "twig/ui8kit/compose/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    }
  }
}
