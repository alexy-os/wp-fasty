{* WP FastY kit — Alert: composition over UI8Kit 3 Box + the codegen-x alert recipe (presets/components/alert.json); role alert|status kept for live regions. *}
{parameters
  string $class = '',
  string $variant = '',
  string $role = '',
  string $ariaLive = '',
  array $attrs = [],
  string $children = '',
}
{include 'box/Box.latte', class: kit('alert', ['variant' => $variant], $class), attrs: ['role' => $role === 'alert' ? 'alert' : 'status', 'aria-live' => $ariaLive === '' ? 'polite' : $ariaLive, ...$attrs], children: $children}
