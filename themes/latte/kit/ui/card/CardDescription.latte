{* WP FastY kit — CardDescription: composition over UI8Kit 3 Text + presets/components/card.json (legacy xgen API kept for views). *}
{parameters
  string $class = '',
  array $attrs = [],
  string $children = '',
}
{include 'text/Text.latte', class: kit('card.CardDescription', [], $class), attrs: $attrs, children: $children}
