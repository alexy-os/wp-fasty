{* WP FastY kit — Card: composition over UI8Kit 3 Box + the codegen-x card recipe and kit-compose card parts (presets/components/card.json). *}
{parameters
  string $class = '',
  string $variant = '',
  array $attrs = [],
  string $children = '',
}
{include 'box/Box.latte', class: kit('card', ['variant' => $variant], $class), attrs: $attrs, children: $children}
