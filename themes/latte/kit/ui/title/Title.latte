{* WP FastY kit — Title: composition over UI8Kit 3 Text + the codegen-x title recipe (presets/components/title.json): size, weight. *}
{parameters
  string $class = '',
  int $as = 0,
  string $size = '',
  string $weight = '',
  array $attrs = [],
  string $children = '',
}
{include 'text/Text.latte', tag: 'h' . (in_array($as, [1, 3, 4, 5, 6], true) ? $as : 2), class: kit('title', ['size' => $size, 'weight' => $weight], $class), attrs: $attrs, children: $children}
