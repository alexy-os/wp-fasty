{* WP FastY kit — Badge: composition over UI8Kit 3 Box + presets/components/badge.json (legacy xgen API kept for views). *}
{parameters
  string $variant = '',
  string $size = '',
  string $class = '',
  array $attrs = [],
  string $children = '',
}
{include 'box/Box.latte', class: kit('badge', ['variant' => $variant, 'size' => $size], $class), attrs: $attrs, children: $children}
