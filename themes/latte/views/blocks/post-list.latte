{**
 * Block: post-list
 * Context: posts[], pagination, labels
 *}
{capture $list}
	{if empty($posts)}
		{capture $c_ui1}{$labels['no_posts'] ?? 'No posts found.'}{/capture}{include 'text/Text.latte', tag: 'p', class: 'py-16 text-center text-muted-foreground', children: (string) $c_ui1, attrs: []}
	{else}
		{capture $cards}
			{foreach $posts as $post}
				{capture $body}
					{capture $postTitle}{$post['title']}{/capture}
					{capture $t}{include 'link/Link.latte', href: $post['url'], class: kit('link', []), children: (string) $postTitle}{/capture}
					{capture $h}{include 'card/CardTitle.latte', children: (string) $t}{/capture}
					{include 'card/CardHeader.latte', children: (string) $h}
					{if !empty($post['excerpt'])}
						{capture $ex}{capture $c_ui2}{$post['excerpt']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-sm text-muted-foreground', children: (string) $c_ui2, attrs: []}{/capture}
						{include 'card/CardContent.latte', children: (string) $ex}
					{/if}
					{if !empty($post['date']['display'])}
						{capture $ft}{capture $c_ui3}{$post['date']['display']}{/capture}{include 'text/Text.latte', tag: 'time', class: 'text-xs text-muted-foreground', children: (string) $c_ui3, attrs: ['datetime' => ($post['date']['iso'] ?? '')]}{/capture}
						{include 'card/CardFooter.latte', children: (string) $ft}
					{/if}
				{/capture}
				{include 'card/Card.latte', variant: 'compact', class: $post['post_class'] ?? '', children: (string) $body}
			{/foreach}
		{/capture}
		{include 'stack/Stack.latte', gap: '6', children: (string) $cards}
	{/if}

	{if !empty($pagination)}
		{capture $c_ui5}
			{if $pagination['prev_url']}
				{capture $prevL}{$labels['previous'] ?? 'Previous'}{/capture}
				{include 'link/Link.latte', href: $pagination['prev_url'], class: kit('link', ['size' => 'sm']), children: (string) $prevL}
			{/if}
			{capture $c_ui4}{$pagination['current']} / {$pagination['total']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm text-muted-foreground', children: (string) $c_ui4, attrs: []}
			{if $pagination['next_url']}
				{capture $nextL}{$labels['next'] ?? 'Next'}{/capture}
				{include 'link/Link.latte', href: $pagination['next_url'], class: kit('link', ['size' => 'sm']), children: (string) $nextL}
			{/if}
		{/capture}{include 'box/Box.latte', tag: 'nav', class: 'mt-10 flex justify-center gap-4', children: (string) $c_ui5, attrs: ['aria-label' => ($labels['pagination'] ?? 'Pagination')]}
	{/if}
{/capture}

{capture $box}
	{include 'box/Box.latte', class: 'container mx-auto px-4 py-12 md:px-6', children: (string) $list}
{/capture}
{include 'block/Block.latte', tag: 'section', children: (string) $box}
