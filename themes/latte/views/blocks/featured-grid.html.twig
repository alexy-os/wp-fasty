{#
 # Block: featured-grid — UI8Kit Card + Image primitives (Twig twin of featured-grid.latte).
 # Context: posts[], labels
 #}
{% if posts is defined and posts|length > 0 %}
	{% set cards %}
		{% for post in posts %}
			{% set cardBody %}
				{% if post.thumbnail.url ?? false %}
					{% set thumb %}
						{% include 'image/Image.html.twig' with {
							src: post.thumbnail.url,
							alt: post.thumbnail.alt ?? '',
							width: (post.thumbnail.width ?? '') ~ '',
							height: (post.thumbnail.height ?? '') ~ '',
							sizes: post.thumbnail.sizes ?? '',
							class: kit('image', {}, 'aspect-video w-full object-cover'),
							loading: 'lazy',
							srcSet: post.thumbnail.srcset ?? '',
							decoding: 'async'
						} %}
					{% endset %}
					{% include 'link/Link.html.twig' with { href: post.url, class: kit('link', {'variant': 'block'}, 'overflow-hidden'), ariaLabel: post.title ~ "", children: thumb } %}
				{% endif %}
				{% set postTitle %}{{ post.title }}{% endset %}
				{% set cardTitle %}
					{% include 'link/Link.html.twig' with { href: post.url, class: kit('link', {}), children: postTitle } %}
				{% endset %}
				{% set headerInner %}
					{% include 'card/CardTitle.html.twig' with { class: 'text-xl', children: cardTitle } %}
				{% endset %}
				{% include 'card/CardHeader.html.twig' with { children: headerInner } %}

				{% if post.excerpt ?? false %}
					{% set excerptHtml %}{% set c_ui1 %}{{ post.excerpt }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': c_ui1, 'attrs': {}} only %}{% endset %}
					{% include 'card/CardContent.html.twig' with { children: excerptHtml } %}
				{% endif %}
			{% endset %}
			{% include 'card/Card.html.twig' with { class: 'overflow-hidden', children: cardBody } %}
		{% endfor %}
	{% endset %}

	{% set sectionInner %}
		{% set heading %}{{ labels.featured ?? 'Featured' }}{% endset %}
		{% include 'title/Title.html.twig' with { as: 2, size: '3xl', weight: 'bold', class: 'mb-2 text-center tracking-tight', children: heading } %}
		{% set c_ui2 %}{{ labels.latest_articles ?? 'Latest articles' }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'mb-10 text-center text-muted-foreground', 'children': c_ui2, 'attrs': {}} only %}
		{% include 'grid/Grid.html.twig' with { class: 'grid gap-6 md:grid-cols-2 lg:grid-cols-3', children: cards } %}
	{% endset %}

	{% set sectionBox %}
		{% include 'box/Box.html.twig' with { class: 'container mx-auto px-4 md:px-6', children: sectionInner } %}
	{% endset %}

	{% include 'block/Block.html.twig' with { tag: 'section', class: 'bg-card py-16', children: sectionBox } %}
{% endif %}
