{# 404 — not found (Twig twin of 404.latte) #}
{% set inner %}
	{% set codeHtml %}{{ error.code }}{% endset %}
	{% include 'title/Title.html.twig' with { as: 1, size: '5xl', weight: 'bold', class: 'tracking-tight', children: codeHtml } %}

	{% set titleHtml %}{{ error.title }}{% endset %}
	{% include 'title/Title.html.twig' with { as: 2, size: '2xl', weight: 'semibold', class: 'mt-4 tracking-tight', children: titleHtml } %}

	{% set c_ui1 %}{{ error.message }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'mt-4 max-w-xl text-muted-foreground', 'children': c_ui1, 'attrs': {}} only %}

	{% set c_ui2 %}
		{% include 'blocks/search-form.html.twig' with {searchId: 'latte-search-field-404', searchLabel: labels.search_404 ?? null} %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mt-8 max-w-md', 'children': c_ui2, 'attrs': {}} only %}

	{% set ctaLabel %}{{ error.home_label }}{% endset %}
	{% set cta %}
		{% include 'link/Link.html.twig' with { href: error.home_url, class: kit('link', {}), children: ctaLabel } %}
	{% endset %}
	{% set c_ui3 %}
		{{ cta }}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mt-8', 'children': c_ui3, 'attrs': {}} only %}
{% endset %}
{% set box %}
	{% include 'box/Box.html.twig' with { class: 'container mx-auto px-4 py-20 md:px-6', children: inner } %}
{% endset %}
{% include 'block/Block.html.twig' with { tag: 'section', class: 'min-h-[50vh]', children: box } %}
