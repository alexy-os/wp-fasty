{** 404 — not found *}
{capture $inner}
	{capture $codeHtml}{$error['code']}{/capture}
	{include 'title/Title.latte', as: 1, size: '5xl', weight: 'bold', class: 'tracking-tight', children: (string) $codeHtml}

	{capture $titleHtml}{$error['title']}{/capture}
	{include 'title/Title.latte', as: 2, size: '2xl', weight: 'semibold', class: 'mt-4 tracking-tight', children: (string) $titleHtml}

	{capture $c_ui1}{$error['message']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'mt-4 max-w-xl text-muted-foreground', children: (string) $c_ui1, attrs: []}

	{capture $c_ui2}
		{include 'blocks/search-form.latte', searchId: 'latte-search-field-404', searchLabel: $labels['search_404'] ?? null}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'mt-8 max-w-md', children: (string) $c_ui2, attrs: []}

	{capture $ctaLabel}{$error['home_label']}{/capture}
	{capture $cta}
		{include 'link/Link.latte', href: $error['home_url'], class: kit('link', []), children: (string) $ctaLabel}
	{/capture}
	{capture $c_ui3}
		{$cta|noescape}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'mt-8', children: (string) $c_ui3, attrs: []}
{/capture}
{capture $box}
	{include 'box/Box.latte', class: 'container mx-auto px-4 py-20 md:px-6', children: (string) $inner}
{/capture}
{include 'block/Block.latte', tag: 'section', class: 'min-h-[50vh]', children: (string) $box}
