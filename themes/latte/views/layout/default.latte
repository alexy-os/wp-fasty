{**
 * Document shell — raw HTML allowed here only. DOCTYPE is printed by includes/render.php.
 * Context: site, content, menu, shell, labels
 *}
<html {language_attributes}>
<head>
	<meta charset="{$site['charset'] ?? 'UTF-8'}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	{wp_head}
</head>
<body {body_class 'font-sans bg-background antialiased'}>
	{wp_body_open}
	{if ($shell ?? 'classic') === 'app-shell'}
		{include 'layout/app-shell.latte'}
	{else}
		{include 'layout/parts/header.latte'}

		{if !empty($widgets['sidebar'])}
			{capture $c_ui3}
				{capture $c_ui1}
					{do_action 'before_content'}
					{$content|noescape}
					{do_action 'after_content'}
				{/capture}{include 'box/Box.latte', tag: 'main', class: 'site-content min-w-0 flex-1', children: (string) $c_ui1, attrs: ['id' => 'content']}
				{capture $c_ui2}
					{$widgets['sidebar']|noescape}
				{/capture}{include 'box/Box.latte', tag: 'aside', class: 'w-full shrink-0 py-12 md:w-64', children: (string) $c_ui2, attrs: ['aria-label' => ($labels['sidebar'])]}
			{/capture}{include 'box/Box.latte', tag: 'div', class: 'container mx-auto flex flex-col gap-8 px-4 md:flex-row md:px-6', children: (string) $c_ui3, attrs: []}
		{else}
			{capture $c_ui4}
				{do_action 'before_content'}
				{$content|noescape}
				{do_action 'after_content'}
			{/capture}{include 'box/Box.latte', tag: 'main', class: 'site-content', children: (string) $c_ui4, attrs: ['id' => 'content']}
		{/if}

		{include 'layout/parts/footer.latte'}
	{/if}

	{wp_footer}
</body>
</html>
