{**
 * App-shell body chrome — used when context shell === app-shell.
 *}
<a class="skip-link screen-reader-text" href="#content">{$labels['skip_to_content']}</a>
{include 'layout/parts/mobile-sheet.latte'}

<div class="flex min-h-screen items-stretch">
	{include 'layout/parts/app-sidebar.latte'}
	<div class="flex min-w-0 flex-1 flex-col">
		{include 'layout/parts/app-header.latte'}
		<main id="content" class="site-content flex-1">
			{do_action 'before_content'}
			{$content|noescape}
			{do_action 'after_content'}
		</main>
		{include 'layout/parts/footer.latte'}
	</div>
</div>
