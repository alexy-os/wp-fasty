{**
 * Shared mobile nav sheet — IDs from $sheet context.
 *}
{if !empty($menu['primary']['items'])}
	{capture $c_ui7}
		{include 'box/Box.latte', tag: 'div', class: 'absolute inset-0 bg-foreground/40', attrs: ['data-ui8kit-dialog-close' => 'true', 'data-ui8kit-dialog-target' => ($sheet['panel'])]}
		{capture $c_ui6}
			{capture $c_ui3}
				{capture $c_ui1}{$site['title']}{/capture}{include 'text/Text.latte', tag: 'h2', class: 'text-base font-semibold', children: (string) $c_ui1, attrs: ['id' => ($sheet['title'])]}
				{capture $c_ui2}
					{icon('x', 'size-5')}
				{/capture}{include 'button/Button.latte', class: kit('button', ['variant' => 'outline', 'layout' => 'icon']), children: (string) $c_ui2, attrs: ['type' => 'button', 'data-ui8kit-dialog-close' => 'true', 'data-ui8kit-dialog-target' => ($sheet['panel']), 'aria-label' => ($labels['close_menu'])]}
			{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex h-16 items-center justify-between border-b border-border px-4', children: (string) $c_ui3, attrs: []}
			{capture $c_ui4}
				{include 'nav-items.latte', items: $menu['primary']['items']}
			{/capture}{include 'box/Box.latte', tag: 'nav', class: 'flex-1 overflow-y-auto px-4 py-4', children: (string) $c_ui4, attrs: ['aria-label' => ($labels['mobile_nav'] ?? $labels['primary_nav'])]}
			{capture $c_ui5}
				{include 'blocks/search-form.latte', searchId: 'latte-search-field-sheet', searchLabel: $labels['search_mobile'] ?? null}
			{/capture}{include 'box/Box.latte', tag: 'div', class: 'border-t border-border p-4', children: (string) $c_ui5, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'absolute inset-y-0 left-0 flex w-72 max-w-[85vw] flex-col bg-card shadow-lg', children: (string) $c_ui6, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'fixed inset-0 z-50 md:hidden', children: (string) $c_ui7, attrs: ['id' => ($sheet['panel']), 'role' => 'dialog', 'aria-modal' => 'true', 'aria-labelledby' => ($sheet['title']), 'data-ui8kit' => 'sheet', 'data-ui8kit-dialog' => 'true', 'behavior' => 'ui8kit', 'data-state' => 'closed', 'hidden' => true]}
{/if}
