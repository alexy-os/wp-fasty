{**
 * Site header — classic top nav.
 *}
<header class="site-header border-b border-border bg-background">
	<div class="container mx-auto flex h-16 items-center justify-between px-4 md:px-6">
		<a href="{$site['url']}" class="text-lg font-semibold tracking-tight text-foreground no-underline hover:text-primary">
			{$site['title']}
		</a>

		{if !empty($menu['primary']['items'])}
			<nav class="hidden md:block" aria-label="Primary">
				<ul class="flex items-center gap-6">
					{foreach $menu['primary']['items'] as $item}
						<li>
							<a
								href="{$item['url']}"
								class="text-sm font-medium text-muted-foreground no-underline hover:text-foreground{if $item['current']} text-foreground{/if}"
								{if $item['current']}aria-current="page"{/if}
							>
								{$item['title']}
							</a>
						</li>
					{/foreach}
				</ul>
			</nav>
		{/if}
	</div>
</header>
