{**
 * Site brand — logo image or title text.
 *}
{capture $c_ui1}
	{if !empty($site['logo']['url'])}
		{include 'image/Image.latte',
			src: $site['logo']['url'],
			alt: $site['logo']['alt'] ?? $site['title'],
			width: (string) ($site['logo']['width'] ?? ''),
			height: (string) ($site['logo']['height'] ?? ''),
			class: kit('image', [], 'h-8 w-auto'),
			loading: 'eager',
			decoding: 'async'
		}
	{else}
		{$site['title']}
	{/if}
{/capture}{include 'link/Link.latte', href: ((($site['url'])|checkUrl)) ?? '', class: 'inline-flex items-center gap-2 text-lg font-semibold tracking-tight text-foreground no-underline hover:text-primary', children: (string) $c_ui1, attrs: []}
