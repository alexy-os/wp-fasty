{**
 * Site brand — logo image or title text.
 *}
{capture $c_ui1}
	{if !empty($site['logo']['url'])}
		{include 'image/Image.latte',
			src: $site['logo']['url'],
			alt: $site['logo']['alt'] ?? $site['title'],
			width: (string) ($site['logo']['width'] ?? ''),
			height: (string) ($site['logo']['height'] ?? ''),
			class: kit('image', [], 'h-8 w-auto'),
			loading: 'eager',
			decoding: 'async'
		}
	{else}
		{$site['title']}
	{/if}
{/capture}{include 'link/Link.latte', href: $site['url'] ?? '', class: kit('link', ['variant' => 'nav', 'size' => 'md'], 'tracking-tight'), children: (string) $c_ui1, attrs: []}
