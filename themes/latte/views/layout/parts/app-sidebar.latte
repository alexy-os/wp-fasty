{**
 * Desktop sidebar — hidden on small screens.
 *}
{capture $c_ui4}
	{capture $c_ui1}
		{include 'brand.latte'}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex h-16 items-center border-b border-border px-4', children: (string) $c_ui1, attrs: []}
	{capture $c_ui2}
		{if !empty($menu['primary']['items'])}
			{include 'nav-items.latte', items: $menu['primary']['items']}
		{/if}
	{/capture}{include 'box/Box.latte', tag: 'nav', class: 'flex-1 overflow-y-auto px-4 py-4', children: (string) $c_ui2, attrs: ['aria-label' => ($labels['primary_nav'])]}
	{if !empty($widgets['sidebar'])}
		{capture $c_ui3}
			{$widgets['sidebar']|noescape}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'border-t border-border px-4 py-4 text-sm', children: (string) $c_ui3, attrs: []}
	{/if}
{/capture}{include 'box/Box.latte', tag: 'aside', class: 'hidden w-64 shrink-0 flex-col border-r border-border bg-card md:flex', children: (string) $c_ui4, attrs: ['aria-label' => ($labels['sidebar'])]}
