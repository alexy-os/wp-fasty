{**
 * Desktop sidebar — hidden on small screens.
 *}
<aside class="hidden w-64 shrink-0 flex-col border-r border-border bg-card md:flex" aria-label="{$labels['sidebar']}">
	<div class="flex h-16 items-center border-b border-border px-4">
		{include 'brand.latte'}
	</div>
	<nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="{$labels['primary_nav']}">
		{if !empty($menu['primary']['items'])}
			{include 'nav-items.latte', items: $menu['primary']['items']}
		{/if}
	</nav>
	{if !empty($widgets['sidebar'])}
		<div class="border-t border-border px-4 py-4 text-sm">
			{$widgets['sidebar']|noescape}
		</div>
	{/if}
</aside>
