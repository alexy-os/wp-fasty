{**
 * Desktop sidebar — hidden on small screens.
 *}
<aside class="hidden w-64 shrink-0 flex-col border-r border-border bg-card md:flex" aria-label="Sidebar">
	<div class="flex h-16 items-center border-b border-border px-4">
		<a href="{$site['url']}" class="text-lg font-semibold tracking-tight text-foreground no-underline hover:text-primary">
			{$site['title']}
		</a>
	</div>
	<nav class="flex-1 px-3 py-4" aria-label="Primary navigation">
		{if !empty($menu['primary']['items'])}
			<ul class="flex flex-col gap-1">
				{foreach $menu['primary']['items'] as $item}
					<li>
						<a
							href="{$item['url']}"
							class="block rounded-md px-3 py-2 text-sm font-medium text-muted-foreground no-underline hover:bg-accent hover:text-foreground{if $item['current']} bg-accent text-foreground{/if}"
							{if $item['current']}aria-current="page"{/if}
						>
							{$item['title']}
						</a>
					</li>
				{/foreach}
			</ul>
		{/if}
	</nav>
</aside>
