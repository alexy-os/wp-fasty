{**
 * Mobile nav sheet — SSR valid without JS; ui8kit.js owns open state after mount.
 * open attribute is initial SSR state only when behavior=ui8kit.
 *}
<div
	id="app-shell-mobile-sheet-panel"
	role="dialog"
	aria-modal="true"
	aria-labelledby="app-shell-mobile-sheet-title"
	data-ui8kit="sheet"
	data-ui8kit-dialog="true"
	behavior="ui8kit"
	data-state="closed"
	hidden
	class="fixed inset-0 z-50 md:hidden"
>
	<div class="absolute inset-0 bg-black/40" data-ui8kit-dialog-close="true" data-ui8kit-dialog-target="app-shell-mobile-sheet-panel"></div>
	<div class="absolute inset-y-0 left-0 flex w-72 max-w-[85vw] flex-col bg-card shadow-lg">
		<div class="flex h-16 items-center justify-between border-b border-border px-4">
			<h2 id="app-shell-mobile-sheet-title" class="text-base font-semibold">{$site['title']}</h2>
			<button
				type="button"
				class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-input text-sm"
				data-ui8kit-dialog-close="true"
				data-ui8kit-dialog-target="app-shell-mobile-sheet-panel"
				aria-label="Close menu"
			>
				×
			</button>
		</div>
		<nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Primary navigation">
			{if !empty($menu['primary']['items'])}
				<ul class="flex flex-col gap-1">
					{foreach $menu['primary']['items'] as $item}
						<li>
							<a
								href="{$item['url']}"
								class="block rounded-md px-3 py-2 text-sm font-medium text-muted-foreground no-underline hover:bg-accent hover:text-foreground{if $item['current']} bg-accent text-foreground{/if}"
								{if $item['current']}aria-current="page"{/if}
							>
								{$item['title']}
							</a>
						</li>
					{/foreach}
				</ul>
			{/if}
		</nav>
	</div>
</div>
