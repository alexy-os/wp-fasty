{#
 # App-shell body chrome — used when context shell === app-shell. Twig twin of app-shell.latte.
 #}
{% set c_ui1 %}{{ labels.skip_to_content }}{% endset %}{% include 'link/Link.html.twig' with {'class': 'skip-link screen-reader-text', 'href': '#content', 'children': c_ui1, 'attrs': {}} only %}
{% include 'layout/parts/mobile-sheet.html.twig' %}

{% set c_ui4 %}
	{% include 'layout/parts/app-sidebar.html.twig' %}
	{% set c_ui3 %}
		{% include 'layout/parts/app-header.html.twig' %}
		{% set c_ui2 %}
			{{ do_action('before_content') }}
			{{ content|raw }}
			{{ do_action('after_content') }}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'main', 'class': 'site-content flex-1', 'children': c_ui2, 'attrs': {'id': 'content'}} only %}
		{% include 'layout/parts/footer.html.twig' %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex min-w-0 flex-1 flex-col', 'children': c_ui3, 'attrs': {}} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex min-h-screen items-stretch', 'children': c_ui4, 'attrs': {}} only %}
