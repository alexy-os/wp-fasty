{** WP FastY — brand lockup: signal mark + wordmark (logo image wins when set). *}
{capture $brand}
	{if !empty($site['logo']['url'])}
		{include 'image/Image.latte', src: $site['logo']['url'], alt: $site['logo']['alt'] ?? $site['title'], class: kit('image', [], 'h-8 w-auto'), loading: 'eager', decoding: 'async'}
	{else}
		{capture $mark}{icon('sparkles', 'size-4')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'inline-flex size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground', children: (string) $mark, attrs: ['aria-hidden' => 'true']}
		{capture $word}{$site['title']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'font-heading text-lg font-bold tracking-tight', children: (string) $word, attrs: []}
	{/if}
{/capture}{include 'link/Link.latte', href: $site['url'] ?? '', class: 'inline-flex items-center gap-2 text-foreground no-underline hover:text-primary', children: (string) $brand, attrs: []}
