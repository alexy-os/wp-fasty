{**
 * Front page content (layout already renders site header/footer).
 *
 * Context: site, page? (static front page), posts? (blog on front), menu
 *}

<section class="hero">
	<div class="container">
		<div class="hero-content">
			<h1 class="hero-title">
				{if isset($page['title']) && $page['title'] !== ''}
					{$page['title']}
				{else}
					{$site['title']}
				{/if}
			</h1>
			{if !empty($site['description'])}
				<p class="hero-description">{$site['description']}</p>
			{/if}
			<div class="hero-actions">
				{capture $explore}Explore{/capture}
				{capture $learn}Learn More{/capture}
				{include 'button/Button.latte', variant: 'default', class: 'rounded-full', children: (string) $explore}
				{include 'button/Button.latte', variant: 'secondary', class: 'rounded-full', children: (string) $learn}
			</div>
		</div>
	</div>
</section>

{if isset($page) && !empty($page['content'])}
	<section id="about" class="about-section">
		<div class="container">
			<div class="about-content">
				{$page['content']|noescape}
			</div>
		</div>
	</section>
{/if}

{if isset($posts) && count($posts) > 0}
	<section id="featured" class="featured-posts">
		<div class="container">
			<header class="section-header">
				<h2 class="section-title">Featured</h2>
				<p class="section-description">Discover our latest articles and updates</p>
			</header>
			<div class="featured-grid">
				{foreach $posts as $post}
					<article class="card card-featured">
						{if !empty($post['thumbnail']['url'])}
							<a href="{$post['url']}" class="card-link">
								<figure class="card-thumbnail">
									<img
										src="{$post['thumbnail']['url']}"
										alt="{$post['thumbnail']['alt'] ?? ''}"
										class="card-image"
									>
								</figure>
							</a>
						{/if}
						<header class="card-header">
							<h3 class="card-title">
								<a href="{$post['url']}">{$post['title']}</a>
							</h3>
						</header>
						{if !empty($post['excerpt'])}
							<div class="card-content">
								<p class="card-excerpt">{$post['excerpt']}</p>
							</div>
						{/if}
					</article>
				{/foreach}
			</div>
		</div>
	</section>
{/if}
