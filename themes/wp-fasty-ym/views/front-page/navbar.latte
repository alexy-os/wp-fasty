{**
 * Front-page navbar (compact)
 *
 * Context: site, menu
 *}
<header class="site-header">
	<div class="container">
		<div class="header-content flex items-center justify-between">
			<a href="{$site['url']}" class="site-logo">{$site['title']}</a>
			{if isset($menu['primary']['items'])}
				<nav class="site-nav" aria-label="Primary">
					<ul class="nav-menu">
						{foreach $menu['primary']['items'] as $item}
							<li class="nav-item{if !empty($item['current'])} is-active{/if}">
								<a href="{$item['url']}" class="nav-link">{$item['title']}</a>
							</li>
						{/foreach}
					</ul>
				</nav>
			{/if}
		</div>
	</div>
</header>
