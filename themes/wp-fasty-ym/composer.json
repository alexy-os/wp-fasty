{
  "name": "godudy/wp-fasty-ym",
  "description": "WP FastY YM — reference Latte theme (UI8Kit primitives)",
  "type": "wordpress-theme",
  "license": "MIT",
  "authors": [
    {
      "name": "godudy"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../../.workspaces/ui8kit-latte",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": ">=8.2",
    "latte/latte": "^3.0",
    "ui8kit/latte-primitives": "@dev"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^2.3",
    "phpcompatibility/php-compatibility": "^9.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
    "slevomat/coding-standard": "^8.0",
    "squizlabs/php_codesniffer": "^3.12"
  },
  "autoload": {
    "psr-4": {
      "WPFasty\\": "classes/"
    }
  },
  "autoload-dev": {
    "files": [
      "includes/helpers.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2"
    },
    "optimize-autoloader": true,
    "sort-packages": true,
    "vendor-dir": "vendor"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  }
}
