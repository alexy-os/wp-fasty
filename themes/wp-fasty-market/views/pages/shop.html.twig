{# WP FastY — catalog: filters sidebar (category, price, compatibility, rating), sort, item grid, pager. #}
{% include 'blocks/notice.html.twig' %}
{% set head %}
	{% set crumbs %}
		{% set h %}{{ archive['title'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h1', 'class': 'font-heading text-3xl font-bold tracking-tight md:text-4xl', 'children': h, 'attrs': []} only %}
		{% if not ((archive['description']) is empty) %}{% set d %}{{ archive['description']|raw }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'max-w-2xl text-muted-foreground', 'children': d, 'attrs': []} only %}{% endif %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col gap-2', 'children': crumbs, 'attrs': []} only %}
	{% include 'blocks/search-bar.html.twig' %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto flex flex-col gap-6 px-4 pb-8 pt-12 md:px-6', 'children': head, 'attrs': []} only %}

{% set body %}
	{% set side %}
		{% set f %}
			{% set ft %}{{ icon('tag', 'size-4') }}{{ labels['filters'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'flex items-center gap-2 font-heading text-lg font-bold', 'children': ft, 'attrs': []} only %}

			{% set grp %}
				{% set lg %}{{ labels['category'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h3', 'class': 'text-xs font-semibold uppercase tracking-widest text-muted-foreground', 'children': lg, 'attrs': []} only %}
				{% set list %}
					{% set li %}{% set n %}{{ labels['all_products'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': shop['url'] ?? '', 'class': (shop['current_cat'] == '' ? 'flex rounded-lg bg-accent px-3 py-2 text-sm font-semibold text-accent-foreground no-underline' : 'flex rounded-lg px-3 py-2 text-sm text-foreground no-underline hover:bg-muted'), 'children': n, 'attrs': {'data-control': 'chip'}} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'li', 'children': li, 'attrs': []} only %}
					{% for cat in shop['categories'] %}
						{% set li %}{% set n %}{{ cat['name'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': cat['url'] ?? '', 'class': (shop['current_cat'] == cat['slug'] ? 'flex rounded-lg bg-accent px-3 py-2 text-sm font-semibold text-accent-foreground no-underline' : 'flex rounded-lg px-3 py-2 text-sm text-foreground no-underline hover:bg-muted'), 'children': n, 'attrs': {'data-control': 'chip'}} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'li', 'children': li, 'attrs': []} only %}
					{% endfor %}
				{% endset %}{% include 'box/Box.html.twig' with {'tag': 'ul', 'class': 'flex flex-col', 'children': list, 'attrs': []} only %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col gap-2', 'children': grp, 'attrs': []} only %}

			{% set grp %}
				{% set lg %}{{ labels['price'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'legend', 'class': 'mb-2 text-xs font-semibold uppercase tracking-widest text-muted-foreground', 'children': lg, 'attrs': []} only %}
				{% for opt in shop['prices'] %}
					{% set row %}{% include 'radio/Radio.html.twig' with {'name': 'price', 'value': opt['id'], 'checked': shop['price'] == opt['id'], 'class': 'size-4 accent-primary'} only %}{{ opt['label'] }}{% endset %}{% include 'label/Label.html.twig' with {'class': 'flex cursor-pointer items-center gap-2 py-2 text-sm', 'children': row} only %}
				{% endfor %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'fieldset', 'class': 'flex flex-col', 'children': grp, 'attrs': []} only %}

			{% set grp %}
				{% set lg %}{{ labels['compatibility'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'legend', 'class': 'mb-2 text-xs font-semibold uppercase tracking-widest text-muted-foreground', 'children': lg, 'attrs': []} only %}
				{% for opt in shop['compat'] %}
					{% set row %}{% include 'checkbox/Checkbox.html.twig' with {'name': 'compat[]', 'value': opt['id'], 'class': 'size-4 accent-primary'} only %}{{ opt['label'] }}{% endset %}{% include 'label/Label.html.twig' with {'class': 'flex cursor-pointer items-center gap-2 py-2 text-sm', 'children': row} only %}
				{% endfor %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'fieldset', 'class': 'flex flex-col', 'children': grp, 'attrs': []} only %}

			{% set grp %}
				{% set lg %}{{ labels['rating'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'legend', 'class': 'mb-2 text-xs font-semibold uppercase tracking-widest text-muted-foreground', 'children': lg, 'attrs': []} only %}
				{% for c_row in [[0, 'rating_any'], [4, 'rating_4']] %}{% set val = c_row[0] %}{% set key = c_row[1] %}
					{% set row %}{% include 'radio/Radio.html.twig' with {'name': 'rating', 'value': val, 'checked': shop['rating'] == val, 'class': 'size-4 accent-primary'} only %}{{ labels[key] }}{% endset %}{% include 'label/Label.html.twig' with {'class': 'flex cursor-pointer items-center gap-2 py-2 text-sm', 'children': row} only %}
				{% endfor %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'fieldset', 'class': 'flex flex-col', 'children': grp, 'attrs': []} only %}

			{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'sort', 'value': (shop['sort'])}} only %}
			{% set btns %}
				{% set ap %}{{ labels['apply'] }}{% endset %}{% include 'button/Button.html.twig' with {'type': 'submit', 'class': kit('button', [], 'flex-1 rounded-lg'), 'children': ap} only %}
				{% set rs %}{{ labels['reset'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': shop['url'] ?? '', 'class': kit('button', {'variant': 'outline'}, 'rounded-lg no-underline'), 'children': rs, 'attrs': []} only %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex gap-2', 'children': btns, 'attrs': []} only %}
		{% endset %}{% include 'form/Form.html.twig' with {'action': '', 'class': 'flex flex-col gap-6 rounded-xl border border-border bg-card p-6', 'children': f, 'attrs': {'method': 'get', 'aria-label': (labels['filters'])}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'aside', 'class': 'lg:col-span-1', 'children': side, 'attrs': []} only %}

	{% set main %}
		{% set bar %}
			{% set cnt %}{{ ((posts ?? [])|length) }} {{ labels['results'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': cnt, 'attrs': []} only %}
			{% set sf %}
				{% set sl %}{{ labels['sort_by'] }}{% endset %}{% include 'label/Label.html.twig' with {'htmlFor': 'market-sort', 'class': 'text-sm text-muted-foreground', 'children': sl} only %}
				{% set opts %}
					{% for s in shop['sorts'] %}{% set o %}{{ s['label'] }}{% endset %}{% include 'select/SelectOption.html.twig' with {'value': s['id'], 'selected': shop['sort'] == s['id'], 'children': o} only %}{% endfor %}
				{% endset %}{% include 'select/Select.html.twig' with {'id': 'market-sort', 'name': 'sort', 'class': 'h-10 rounded-lg border border-input bg-card px-4 text-sm text-foreground', 'children': opts} only %}
				{% if shop['price'] != 'any' %}{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'price', 'value': (shop['price'])}} only %}{% endif %}
				{% if shop['rating'] > 0 %}{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'rating', 'value': (shop['rating'])}} only %}{% endif %}
				{% set noscript %}{{ labels['apply'] }}{% endset %}{% include 'button/Button.html.twig' with {'type': 'submit', 'class': kit('button', {'variant': 'outline', 'size': 'sm'}, 'rounded-lg'), 'children': noscript} only %}
			{% endset %}{% include 'form/Form.html.twig' with {'action': '', 'class': 'flex items-center gap-2', 'children': sf, 'attrs': {'method': 'get'}} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mb-6 flex flex-wrap items-center justify-between gap-4', 'children': bar, 'attrs': []} only %}
		{% if ((posts) is empty) %}
			{% set e %}{{ labels['no_products'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'rounded-xl border border-dashed border-border py-16 text-center text-muted-foreground', 'children': e, 'attrs': []} only %}
		{% else %}
			{% set grid %}
				{% for product in posts %}
					{% include 'blocks/product-card.html.twig' with {'product': product, 'shop': shop, 'labels': labels, 'headingTag': 'h2'} %}
				{% endfor %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid gap-6 sm:grid-cols-2 xl:grid-cols-3', 'children': grid, 'attrs': []} only %}
			{% if not ((pagination) is empty) %}
				{% set pg %}
					{% if pagination['prev_url'] %}{% set pv %}{{ icon('arrow-left') }}{{ labels['previous'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': pagination['prev_url'] ?? '', 'class': kit('button', {'variant': 'outline'}, 'rounded-lg no-underline'), 'children': pv, 'attrs': []} only %}{% endif %}
					{% set cur %}{{ pagination['current'] }} / {{ pagination['total'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-sm text-muted-foreground', 'children': cur, 'attrs': []} only %}
					{% if pagination['next_url'] %}{% set nx %}{{ labels['next'] }}{{ icon('arrow-right') }}{% endset %}{% include 'link/Link.html.twig' with {'href': pagination['next_url'] ?? '', 'class': kit('button', {'variant': 'outline'}, 'rounded-lg no-underline'), 'children': nx, 'attrs': []} only %}{% endif %}
				{% endset %}{% include 'box/Box.html.twig' with {'tag': 'nav', 'class': 'mt-10 flex items-center justify-center gap-4', 'children': pg, 'attrs': {'aria-label': (labels['pagination'] ?? 'Pagination')}} only %}
			{% endif %}
		{% endif %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'lg:col-span-3', 'children': main, 'attrs': []} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto grid gap-8 px-4 pb-16 md:px-6 lg:grid-cols-4', 'children': body, 'attrs': []} only %}
