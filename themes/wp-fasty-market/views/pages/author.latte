{** WP FastY — author storefront (?a=slug): profile, stats, items. Author data is fixture-backed until wpfasty-types has an Author type. *}
{if !empty($author)}
	{capture $hero}
		{capture $inner}
			{capture $av}{mb_substr($author['name'], 0, 1)}{/capture}{include 'text/Text.latte', tag: 'span', class: 'inline-flex size-24 shrink-0 items-center justify-center rounded-2xl bg-primary font-heading text-4xl font-extrabold text-primary-foreground', children: (string) $av, attrs: ['aria-hidden' => 'true']}
			{capture $tx}
				{capture $r}{$author['role']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-xs font-semibold uppercase tracking-widest text-primary', children: (string) $r, attrs: []}
				{capture $h}{$author['name']}{/capture}{include 'text/Text.latte', tag: 'h1', class: 'font-heading text-4xl font-extrabold tracking-tight', children: (string) $h, attrs: []}
				{capture $s}{$labels['since']} {$author['since']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm text-secondary-foreground/70', children: (string) $s, attrs: []}
			{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-1 flex-col gap-2', children: (string) $tx, attrs: []}
			{capture $stats}
				{foreach [[$author['items'], $labels['items']], [$author['sales'], $labels['sales']], ['★ ' . $author['rating'], $labels['rating']]] as [$val, $lbl]}
					{capture $dd}{capture $a}{$val}{/capture}{include 'box/Box.latte', tag: 'dd', class: 'font-heading text-2xl font-bold', children: (string) $a, attrs: []}{capture $b}{$lbl}{/capture}{include 'box/Box.latte', tag: 'dt', class: 'text-xs text-secondary-foreground/70', children: (string) $b, attrs: []}{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col-reverse', children: (string) $dd, attrs: []}
				{/foreach}
			{/capture}{include 'box/Box.latte', tag: 'dl', class: 'flex gap-8', children: (string) $stats, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-6 rounded-2xl bg-secondary p-8 text-secondary-foreground md:flex-row md:items-center md:p-12', children: (string) $inner, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 pt-8 md:px-6', children: (string) $hero, attrs: []}
	{include 'blocks/product-grid.latte', title: $labels['author_items'], products: $products ?? []}
{/if}
