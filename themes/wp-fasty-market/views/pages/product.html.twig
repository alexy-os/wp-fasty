{# WP FastY — item page: preview + gallery, live preview, licenses, compatibility, support, changelog, reviews. #}
{% include 'blocks/notice.html.twig' %}
{% if page %}
{% set d = page['digital'] ?? [] %}
{% set wrap %}
	{% set crumbs %}
		{% set n %}{{ labels['all_products'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': shop['url'] ?? '', 'class': 'text-muted-foreground no-underline hover:text-foreground', 'children': n, 'attrs': []} only %}
		{% if not ((page['product_cats']) is empty) %}
			{{ icon('chevron-right', 'size-4') }}
			{% set n %}{{ page['product_cats'][0]['name'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': page['product_cats'][0]['url'] ?? '', 'class': 'text-muted-foreground no-underline hover:text-foreground', 'children': n, 'attrs': []} only %}
		{% endif %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'nav', 'class': 'flex items-center gap-2 text-sm text-muted-foreground', 'children': crumbs, 'attrs': {'aria-label': (labels['breadcrumb'])}} only %}

	{% set title %}
		{% set h %}{{ page['title'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h1', 'class': 'font-heading text-3xl font-extrabold tracking-tight md:text-5xl', 'children': h, 'attrs': []} only %}
		{% set meta %}
			{% if not ((d['author']) is empty) %}{% set a %}{{ labels['by'] }} {% set an %}{{ d['author']['name'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': d['author']['url'] ?? '', 'class': 'font-semibold text-foreground no-underline hover:text-primary', 'children': an, 'attrs': []} only %}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'children': a, 'attrs': []} only %}{% endif %}
			{% set r %}{{ icon('star', 'size-4 text-primary') }}{{ ((page['rating'] ?? 0)|number_format(1, '.', ',')) }} · {{ page['reviews'] ?? 0 }} {{ labels['reviews'] | lower }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex items-center gap-2', 'children': r, 'attrs': []} only %}
			{% set s %}{{ icon('shopping-bag', 'size-4') }}{{ d['sales'] ?? 0 }} {{ labels['sales'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex items-center gap-2', 'children': s, 'attrs': []} only %}
			{% set u %}{{ icon('clock', 'size-4') }}{{ labels['updated'] }}: {{ d['updated'] ?? '' }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex items-center gap-2', 'children': u, 'attrs': []} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground', 'children': meta, 'attrs': []} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'header', 'class': 'flex flex-col gap-4', 'children': title, 'attrs': []} only %}

	{% set grid %}
		{% set left %}
			{% set stage %}
				{% if not ((page['featuredImage']['url']) is empty) %}
					{% include 'image/Image.html.twig' with {'src': page['featuredImage']['url'], 'alt': page['featuredImage']['alt'] ?? '', 'sizes': '(min-width: 1024px) 66vw, 100vw', 'class': kit('image', [], 'aspect-video w-full object-cover'), 'loading': 'eager', 'srcSet': page['featuredImage']['srcset'] ?? '', 'decoding': 'async'} only %}
				{% else %}
					{% set ph %}{{ icon('layers', 'size-8') }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex aspect-video items-center justify-center text-muted-foreground', 'children': ph, 'attrs': []} only %}
				{% endif %}
				{% if not ((d['preview_url']) is empty) %}
					{% set lp %}{{ icon('eye', 'size-4') }}{{ labels['live_preview'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': d['preview_url'], 'class': 'absolute bottom-4 right-4 inline-flex h-10 items-center gap-2 rounded-lg bg-secondary px-4 text-sm font-semibold text-secondary-foreground no-underline hover:bg-primary hover:text-primary-foreground', 'children': lp, 'attrs': {'target': '_blank', 'rel': 'noopener'}} only %}
				{% endif %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'relative overflow-hidden rounded-xl border border-border bg-muted', 'children': stage, 'attrs': []} only %}
			{% if not ((page['featuredImage']['url']) is empty) %}
				{% set thumbs %}
					{% for i in [1, 2, 3, 4] %}
						{% set th %}{% include 'image/Image.html.twig' with {'src': page['featuredImage']['url'], 'alt': '', 'class': kit('image', [], 'aspect-video w-full object-cover'), 'loading': 'lazy', 'decoding': 'async'} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'li', 'class': (i == 1 ? 'overflow-hidden rounded-lg border-2 border-primary' : 'overflow-hidden rounded-lg border border-border opacity-70 hover:opacity-100'), 'children': th, 'attrs': []} only %}
					{% endfor %}
				{% endset %}{% include 'box/Box.html.twig' with {'tag': 'ul', 'class': 'grid grid-cols-4 gap-2', 'children': thumbs, 'attrs': {'aria-label': (labels['gallery'])}} only %}
			{% endif %}

			{% set desc %}
				{% set h %}{{ labels['description'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'font-heading text-xl font-bold', 'children': h, 'attrs': []} only %}
				{% if not ((page['excerpt']) is empty) %}{% set ex %}{{ page['excerpt'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-lg text-muted-foreground', 'children': ex, 'attrs': []} only %}{% endif %}
				{% set c %}{{ page['content']|raw }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'prose max-w-none', 'children': c, 'attrs': []} only %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'flex flex-col gap-4 rounded-xl border border-border bg-card p-6', 'children': desc, 'attrs': {'id': 'description'}} only %}

			{% if not ((d['changelog']) is empty) %}
				{% set cl %}
					{% set h %}{{ labels['changelog'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'font-heading text-xl font-bold', 'children': h, 'attrs': []} only %}
					{% set list %}
						{% for entry in d['changelog'] %}
							{% set li %}
								{% set v %}v{{ entry['version'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'badge w-fit rounded-md bg-accent px-2 py-1 font-mono text-xs font-semibold text-accent-foreground', 'children': v, 'attrs': []} only %}
								{% set dt %}{{ entry['date'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-xs text-muted-foreground', 'children': dt, 'attrs': []} only %}
								{% set nt %}{{ entry['notes'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm sm:col-span-3', 'children': nt, 'attrs': []} only %}
							{% endset %}{% include 'box/Box.html.twig' with {'tag': 'li', 'class': 'grid items-center gap-2 py-4 sm:grid-cols-4', 'children': li, 'attrs': []} only %}
						{% endfor %}
					{% endset %}{% include 'box/Box.html.twig' with {'tag': 'ul', 'class': 'flex flex-col divide-y divide-border', 'children': list, 'attrs': []} only %}
				{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'flex flex-col gap-2 rounded-xl border border-border bg-card p-6', 'children': cl, 'attrs': {'id': 'changelog'}} only %}
			{% endif %}

			{% if not ((d['reviews']) is empty) or not ((d['reviews_available']) is empty) %}
				{% set rv %}
					{% set h %}{{ labels['reviews'] }} · ★ {{ ((page['rating'] ?? 0)|number_format(1, '.', ',')) }} ({{ page['reviews'] ?? 0 }}){% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'font-heading text-xl font-bold', 'children': h, 'attrs': []} only %}
					{% if not ((d['reviews']) is empty) %}
						{% set list %}
							{% for rev in d['reviews'] %}
								{% set li %}
									{% set who %}{% set nm %}{{ rev['name'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'font-semibold', 'children': nm, 'attrs': []} only %}{% set st %}{{ ((rev['rating']) > 0 ? (range(1, rev['rating'])|map(c_i => '★')|join) : '') }}{{ ((5 - rev['rating']) > 0 ? (range(1, 5 - rev['rating'])|map(c_i => '☆')|join) : '') }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-primary', 'children': st, 'attrs': {'role': 'img', 'aria-label': (rev['rating'] ~ '/5')}} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex items-center justify-between gap-4', 'children': who, 'attrs': []} only %}
									{% if rev['verified'] %}{% set vb %}{{ icon('badge-check', 'size-4') }}{{ labels['verified_buyer'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex items-center gap-2 text-xs font-semibold text-primary', 'children': vb, 'attrs': []} only %}{% endif %}
									{% set tx %}{{ rev['text'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': tx, 'attrs': []} only %}
								{% endset %}{% include 'box/Box.html.twig' with {'tag': 'li', 'class': 'flex flex-col gap-2 rounded-lg bg-muted p-4', 'children': li, 'attrs': []} only %}
							{% endfor %}
						{% endset %}{% include 'box/Box.html.twig' with {'tag': 'ul', 'class': 'grid gap-4 md:grid-cols-3', 'children': list, 'attrs': []} only %}
					{% else %}
						{% set nr %}{{ labels['no_reviews'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': nr, 'attrs': []} only %}
					{% endif %}
					{% if not ((d['reviews_available']) is empty) %}
						{% set rf %}
							{% set rh %}{{ labels['write_review'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h3', 'class': 'font-heading text-base font-bold', 'children': rh, 'attrs': []} only %}
							{% set rn %}{{ icon('shield-check', 'size-4') }}{{ labels['review_note'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'flex gap-2 text-xs text-muted-foreground', 'children': rn, 'attrs': []} only %}
							{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'comment_post_ID', 'value': (page['id'])}} only %}
							{% set rg %}
								{% for c_row in [['author', 'your_name', 'text', 'name'], ['email', 'your_email', 'email', 'email']] %}{% set fn = c_row[0] %}{% set fl = c_row[1] %}{% set ft = c_row[2] %}{% set fa = c_row[3] %}
									{% set fld %}
										{% set lbl %}{{ labels[fl] }} *{% endset %}{% include 'label/Label.html.twig' with {'htmlFor': 'rv-' ~ fn, 'class': kit('label', []), 'children': lbl} only %}
										{% include 'input/Input.html.twig' with {'id': 'rv-' ~ fn, 'type': ft, 'name': fn, 'required': true, 'class': kit('input', [], 'rounded-lg'), 'attrs': {'autocomplete': fa}} only %}
									{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col gap-2', 'children': fld, 'attrs': []} only %}
								{% endfor %}
								{% set fld %}
									{% set lbl %}{{ labels['your_rating'] }} *{% endset %}{% include 'label/Label.html.twig' with {'htmlFor': 'rv-rating', 'class': kit('label', []), 'children': lbl} only %}
									{% set ro %}{% for n in [5, 4, 3, 2, 1] %}{% set o %}{{ ((n) > 0 ? (range(1, n)|map(c_i => '★')|join) : '') }}{% endset %}{% include 'select/SelectOption.html.twig' with {'value': n, 'children': o} only %}{% endfor %}{% endset %}{% include 'select/Select.html.twig' with {'id': 'rv-rating', 'name': 'rating', 'required': true, 'class': 'h-10 rounded-lg border border-input bg-card px-4 text-sm text-primary', 'children': ro} only %}
								{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col gap-2', 'children': fld, 'attrs': []} only %}
							{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid gap-4 md:grid-cols-3', 'children': rg, 'attrs': []} only %}
							{% set fld %}
								{% set lbl %}{{ labels['review_text'] }} *{% endset %}{% include 'label/Label.html.twig' with {'htmlFor': 'rv-comment', 'class': kit('label', []), 'children': lbl} only %}
								{% include 'textarea/Textarea.html.twig' with {'id': 'rv-comment', 'name': 'comment', 'rows': '4', 'required': true, 'class': 'rounded-lg border border-input bg-card px-4 py-2 text-sm text-foreground'} only %}
							{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col gap-2', 'children': fld, 'attrs': []} only %}
							{% set sb %}{{ icon('send', 'size-4') }}{{ labels['submit_review'] }}{% endset %}
							{% include 'button/Button.html.twig' with {'type': 'submit', 'class': kit('button', [], 'w-fit rounded-lg font-semibold'), 'children': sb} only %}
						{% endset %}{% include 'form/Form.html.twig' with {'action': d['review_action'] ?? '', 'class': 'flex flex-col gap-4 border-t border-border pt-6', 'children': rf, 'attrs': {'method': 'post', 'id': 'review-form'}} only %}
					{% endif %}
				{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'flex flex-col gap-4 rounded-xl border border-border bg-card p-6', 'children': rv, 'attrs': {'id': 'reviews'}} only %}
			{% endif %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex min-w-0 flex-col gap-6 lg:col-span-2', 'children': left, 'attrs': []} only %}

		{% set right %}
			{% set buy %}
				{% set lt %}{{ labels['license'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'mb-2 text-xs font-semibold uppercase tracking-widest text-muted-foreground', 'children': lt, 'attrs': []} only %}
				{% if ((d['licenses']) is empty) %}
					{% set lp %}{{ page['product']['price'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'font-heading text-2xl font-bold', 'children': lp, 'attrs': []} only %}
				{% endif %}
				{% for lic in d['licenses'] %}
					{% set opt %}
						{% include 'radio/Radio.html.twig' with {'name': 'license', 'value': lic['id'], 'checked': loop.first, 'class': 'mt-2 size-4 accent-primary'} only %}
						{% set lx %}
							{% set ln %}{{ labels['license_' ~ lic['id']] ?? lic['label'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'font-semibold', 'children': ln, 'attrs': []} only %}
							{% if (labels['license_' ~ lic['id'] ~ '_text'] is defined) %}{% set ld %}{{ labels['license_' ~ lic['id'] ~ '_text'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-xs text-muted-foreground', 'children': ld, 'attrs': []} only %}{% endif %}
							{% set lp %}{{ lic['price'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'font-heading text-2xl font-bold', 'children': lp, 'attrs': []} only %}
						{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'flex flex-1 flex-col gap-1', 'children': lx, 'attrs': {'data-control': 'option'}} only %}
					{% endset %}{% include 'label/Label.html.twig' with {'class': 'flex cursor-pointer items-start gap-4 rounded-lg border border-border p-4 hover:border-primary', 'children': opt} only %}
				{% endfor %}
				{% set inc %}{{ icon('check', 'size-4 text-primary') }}{{ labels['included'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'flex gap-2 text-xs text-muted-foreground', 'children': inc, 'attrs': []} only %}
				{% if ((shop['cart_available']) is empty) %}
					{% set un %}{{ icon('circle-alert', 'size-4') }}{{ labels['unavailable_text'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'flex gap-2 text-sm text-muted-foreground', 'children': un, 'attrs': {'role': 'status'}} only %}
				{% elseif page['product']['purchasable'] %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'action', 'value': 'latte_shop_cart'}} only %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'op', 'value': 'add'}} only %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'qty', 'value': '1'}} only %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'product_id', 'value': (page['id'])}} only %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': '_wpnonce', 'value': (shop['cart_nonce'])}} only %}
					{% set add %}{{ icon('shopping-cart', 'size-4') }}{{ labels['add_to_cart'] }}{% endset %}
					{% include 'button/Button.html.twig' with {'type': 'submit', 'class': kit('button', {'size': 'lg'}, 'w-full rounded-lg font-semibold'), 'children': add} only %}
					{% set bn %}{{ labels['buy_now'] }}{% endset %}
					{% include 'button/Button.html.twig' with {'type': 'submit', 'attrs': {'name': 'buy_now', 'value': '1'}, 'class': kit('button', {'variant': 'outline', 'size': 'lg'}, 'w-full rounded-lg'), 'children': bn} only %}
				{% else %}
					{% set oos %}{{ labels['out_of_stock'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': oos, 'attrs': []} only %}
				{% endif %}
				{% if not ((d['preview_url']) is empty) %}
					{% set lp %}{{ icon('external-link', 'size-4') }}{{ labels['live_preview'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': d['preview_url'], 'class': 'inline-flex items-center justify-center gap-2 text-sm font-semibold text-primary no-underline hover:underline', 'children': lp, 'attrs': {'target': '_blank', 'rel': 'noopener'}} only %}
				{% endif %}
			{% endset %}{% if not ((shop['cart_available']) is empty) and page['product']['purchasable'] %}{% include 'form/Form.html.twig' with {'action': shop['action'] ?? '', 'class': 'flex flex-col gap-4 rounded-xl border border-border bg-card p-6', 'children': buy, 'attrs': {'method': 'post'}} only %}{% else %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col gap-4 rounded-xl border border-border bg-card p-6', 'children': buy, 'attrs': []} only %}{% endif %}

			{% set spec %}
				{% set h %}{{ labels['compatibility'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'font-heading text-base font-bold', 'children': h, 'attrs': []} only %}
				{% set dl %}
					{% for c_row in [['version', d['version'] ?? ''], ['updated', d['updated'] ?? ''], ['wp_version', ((d['wp']) is empty) ? '' : d['wp'] ~ '+'], ['php_version', ((d['php']) is empty) ? '' : d['php'] ~ '+']] %}{% set k = c_row[0] %}{% set val = c_row[1] %}
						{% if not (val == '') %}
						{% set row %}{% set dt %}{{ labels[k] }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'dt', 'class': 'text-muted-foreground', 'children': dt, 'attrs': []} only %}{% set dd %}{{ val }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'dd', 'class': 'font-mono font-semibold', 'children': dd, 'attrs': []} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex justify-between gap-4 py-2', 'children': row, 'attrs': []} only %}
					{% endif %}{% endfor %}
				{% endset %}{% include 'box/Box.html.twig' with {'tag': 'dl', 'class': 'flex flex-col divide-y divide-border text-sm', 'children': dl, 'attrs': []} only %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'flex flex-col gap-2 rounded-xl border border-border bg-card p-6', 'children': spec, 'attrs': []} only %}

			{% set sup %}
				{% set h %}{{ icon('message-circle', 'size-5 text-primary') }}{{ labels['support'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'flex items-center gap-2 font-heading text-base font-bold', 'children': h, 'attrs': []} only %}
				{% set t %}{{ labels['support_text'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': t, 'attrs': []} only %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'flex flex-col gap-2 rounded-xl border border-border bg-card p-6', 'children': sup, 'attrs': []} only %}

			{% if not ((d['author']) is empty) %}
				{% set au %}
					{% set av %}{{ ((d['author']['name'])|slice(0, 1)) }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-secondary font-heading text-lg font-bold text-secondary-foreground', 'children': av, 'attrs': {'aria-hidden': 'true'}} only %}
					{% set tx %}
						{% set n %}{{ d['author']['name'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'font-semibold text-foreground', 'children': n, 'attrs': []} only %}
						{% set r %}{{ d['author']['role'] }} · {{ d['author']['items'] }} {{ labels['items'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-xs text-muted-foreground', 'children': r, 'attrs': []} only %}
					{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col', 'children': tx, 'attrs': []} only %}
				{% endset %}{% include 'link/Link.html.twig' with {'href': d['author']['url'] ?? '', 'class': 'flex items-center gap-4 rounded-xl border border-border bg-card p-6 no-underline hover:border-primary', 'children': au, 'attrs': []} only %}
			{% endif %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'aside', 'class': 'flex flex-col gap-6 lg:sticky lg:top-8 lg:self-start', 'children': right, 'attrs': []} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid gap-8 lg:grid-cols-3', 'children': grid, 'attrs': []} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'article', 'class': 'container mx-auto flex flex-col gap-8 px-4 py-12 md:px-6', 'children': wrap, 'attrs': {'id': ('post-' ~ (page['id']))}} only %}
{% endif %}
