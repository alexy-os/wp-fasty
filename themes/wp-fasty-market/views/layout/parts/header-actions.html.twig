{# WP FastY — header actions: cart with live count. #}
{% if not ((shop['cart_available']) is empty) %}
{% set cartIcon %}
	{{ icon('shopping-cart', 'size-5') }}
	{% if shop['count'] > 0 %}
		{% set cnt %}{{ shop['count'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'badge absolute -right-2 -top-2 inline-flex min-w-6 items-center justify-center rounded-full bg-primary px-2 text-xs font-semibold text-primary-foreground', 'children': cnt, 'attrs': []} only %}
	{% endif %}
{% endset %}{% include 'link/Link.html.twig' with {'href': shop['cart_url'] ?? '', 'class': 'relative inline-flex size-10 items-center justify-center rounded-lg border border-border bg-card text-foreground no-underline hover:border-primary hover:text-primary', 'children': cartIcon, 'attrs': {'aria-label': ((labels['cart']) ~ ' (' ~ (shop['count']) ~ ')')}} only %}
{% endif %}
