{# WP FastY — titled row of item cards. Params: $title, $products, $shop, $labels #}
{% if not ((products) is empty) %}
	{% set sec %}
		{% set head %}
			{% set h %}{{ title }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'font-heading text-2xl font-bold tracking-tight md:text-3xl', 'children': h, 'attrs': []} only %}
			{% set all %}{{ labels['view_all'] }}{{ icon('arrow-right', 'size-4') }}{% endset %}{% include 'link/Link.html.twig' with {'href': shop['url'] ?? '', 'class': 'inline-flex items-center gap-2 text-sm font-semibold text-primary no-underline hover:underline', 'children': all, 'attrs': []} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mb-6 flex items-end justify-between gap-4', 'children': head, 'attrs': []} only %}
		{% set grid %}
			{% for product in products %}
				{% include 'blocks/product-card.html.twig' with {'product': product, 'shop': shop, 'labels': labels} %}
			{% endfor %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid gap-6 sm:grid-cols-2 lg:grid-cols-4', 'children': grid, 'attrs': []} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 py-12 md:px-6', 'children': sec, 'attrs': []} only %}
{% endif %}
