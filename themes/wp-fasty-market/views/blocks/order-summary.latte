{** Order totals card. Params: $cart, $labels, $showCheckout (default true) *}
{capture $box}
	{capture $dl}
		{capture $row}{capture $a}{$labels['subtotal']}{/capture}{include 'box/Box.latte', tag: 'dt', class: 'text-muted-foreground', children: (string) $a, attrs: []}{capture $b}{$cart['subtotal_display']}{/capture}{include 'box/Box.latte', tag: 'dd', children: (string) $b, attrs: []}{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex justify-between', children: (string) $row, attrs: []}
		{capture $row}{capture $a}{$labels['total']}{/capture}{include 'box/Box.latte', tag: 'dt', children: (string) $a, attrs: []}{capture $b}{$cart['total_display']}{/capture}{include 'box/Box.latte', tag: 'dd', class: 'font-heading text-2xl', children: (string) $b, attrs: []}{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex items-baseline justify-between border-t border-border pt-4 font-semibold', children: (string) $row, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'dl', class: 'flex flex-col gap-2 text-sm', children: (string) $dl, attrs: []}
	{capture $note}{icon('mail', 'size-4')}{$labels['digital_delivery']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'flex gap-2 rounded-lg bg-muted p-4 text-xs text-muted-foreground', children: (string) $note, attrs: []}
	{if $showCheckout ?? true}
		{capture $go}{icon('credit-card')}{$labels['checkout']}{/capture}{include 'link/Link.latte', href: $shop['checkout_url'] ?? '', class: 'inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90', children: (string) $go, attrs: []}
	{/if}
{/capture}{include 'box/Box.latte', tag: 'aside', class: 'flex h-fit flex-col gap-4 rounded-xl border border-border bg-card p-6', children: (string) $box, attrs: []}
