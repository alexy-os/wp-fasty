{# WP FastY — cookie banner: hidden until JS finds no consent; "Accept all" / "Necessary only" / policy link. #}
{% set box %}
	{% set t %}{{ icon('shield-check', 'size-5 shrink-0 text-primary') }}{% set tx %}{{ labels['cookie_text'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'children': tx, 'attrs': []} only %}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'flex flex-1 gap-2 text-sm', 'children': t, 'attrs': []} only %}
	{% set acts %}
		{% set a %}{{ labels['cookie_accept'] }}{% endset %}{% include 'button/Button.html.twig' with {'type': 'button', 'class': kit('button', [], 'rounded-lg font-semibold'), 'children': a, 'attrs': {'data-cookie': 'all'}} only %}
		{% set n %}{{ labels['cookie_necessary'] }}{% endset %}{% include 'button/Button.html.twig' with {'type': 'button', 'class': kit('button', {'variant': 'outline'}, 'rounded-lg'), 'children': n, 'attrs': {'data-cookie': 'necessary'}} only %}
		{% set s %}{{ labels['legal_cookies'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': legalUrls['cookies'] ?? '', 'class': kit('button', {'variant': 'ghost'}, 'rounded-lg no-underline'), 'children': s, 'attrs': []} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-wrap gap-2', 'children': acts, 'attrs': []} only %}
{% endset %}
{% set inner %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'container mx-auto flex flex-col gap-4 rounded-xl border border-border bg-card p-4 text-card-foreground shadow-lg md:flex-row md:items-center', 'children': box, 'attrs': []} only %}{% endset %}
{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'fixed inset-x-0 bottom-0 z-50 px-4 pb-4', 'children': inner, 'attrs': {'id': 'cookie-banner', 'role': 'region', 'aria-label': (labels['cookie_settings']), 'hidden': true}} only %}
