{# WP FastY — catalog search (GET, product post type). Params: $shop, $labels, $size ('lg' | 'default') #}
{% set f %}
	{% set lbl %}{{ labels['search'] }}{% endset %}{% include 'label/Label.html.twig' with {'htmlFor': 'market-search', 'class': 'sr-only', 'children': lbl} only %}
	{% set field %}
		{% set ic %}{{ icon('search', 'size-5') }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground', 'children': ic, 'attrs': []} only %}
		{% include 'input/Input.html.twig' with {'id': 'market-search', 'type': 'search', 'name': 's', 'value': (search['query'] ?? ''), 'class': kit('input', [], 'h-14 rounded-xl border-transparent bg-card pl-12 pr-32 text-base text-card-foreground'), 'attrs': {'placeholder': (labels['search_placeholder'])}} only %}
		{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'post_type', 'value': 'product'}} only %}
		{% set go %}{{ labels['search'] }}{% endset %}{% include 'button/Button.html.twig' with {'type': 'submit', 'class': kit('button', [], 'absolute right-2 top-2 h-10 rounded-lg px-6 font-semibold'), 'children': go} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'relative', 'children': field, 'attrs': []} only %}
{% endset %}{% include 'form/Form.html.twig' with {'action': shop['search_url'] ?? '', 'class': 'w-full max-w-2xl', 'children': f, 'attrs': {'method': 'get', 'role': 'search'}} only %}
