{**
 * Skin override: hero-centered — demonstrates child view root winning.
 * Context: site, hero
 *}
{capture $heroInner}
	{capture $titleHtml}{$site['title']}{/capture}
	{include 'title/Title.latte', as: 1, size: '4xl', weight: 'bold', class: 'tracking-tight text-primary md:text-6xl', children: (string) $titleHtml}

	{if !empty($site['description'])}
		{capture $descHtml}{capture $c_ui1}{$site['description']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'mt-4 text-lg text-muted-foreground', children: (string) $c_ui1, attrs: []}{/capture}
		{$descHtml|noescape}
	{/if}

	{capture $actions}
		{capture $explore}{$hero['primary_label'] ?? 'Explore'}{/capture}
		{capture $learn}{$hero['secondary_label'] ?? 'Learn more'}{/capture}
		{if !empty($hero['primary_url'])}
			{capture $primary}
				{include 'link/Link.latte', href: $hero['primary_url'], class: kit('button', []), children: (string) $explore}
			{/capture}
			{$primary|noescape}
		{/if}
		{if !empty($hero['secondary_url'])}
			{capture $secondary}
				{include 'link/Link.latte', href: $hero['secondary_url'], class: kit('button', ['variant' => 'secondary']), children: (string) $learn}
			{/capture}
			{$secondary|noescape}
		{/if}
	{/capture}
	{include 'group/Group.latte', class: 'mt-8 flex flex-wrap justify-center gap-4', children: (string) $actions}
{/capture}

{capture $heroBox}
	{include 'box/Box.latte', class: 'mx-auto max-w-3xl text-center', children: (string) $heroInner}
{/capture}

{include 'block/Block.latte', tag: 'section', class: 'bg-muted py-16 md:py-24 latte-skin-hero', children: (string) $heroBox}
