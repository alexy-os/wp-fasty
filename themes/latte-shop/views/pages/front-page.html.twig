{# Latte Shop — home: hero, perks, featured products (Twig twin of front-page.latte). #}
{% include 'blocks/notice.html.twig' %}
{% set c_ui7 %}
	{% set c_ui6 %}
		{% set c_ui5 %}
			{% set c_ui1 %}{% if page.title ?? false %}{{ page.title }}{% else %}{{ site.title }}{% endif %}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h1', 'class': 'text-4xl font-bold leading-tight tracking-tight text-secondary-foreground md:text-5xl', 'children': c_ui1, 'attrs': {}} only %}
			{% if page.excerpt ?? false %}{% set c_ui2 %}{{ page.excerpt }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-lg text-muted-foreground', 'children': c_ui2, 'attrs': {}} only %}{% endif %}
			{% set c_ui4 %}{% set c_ui3 %}{{ icon('shopping-bag') }}{{ labels.shop_now }}{% endset %}{% include 'link/Link.html.twig' with {'href': (((shop.url|safe_url)))|default(''), 'class': 'inline-flex h-12 items-center gap-2 rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90', 'children': c_ui3, 'attrs': {}} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'children': c_ui4, 'attrs': {}} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-col gap-6', 'children': c_ui5, 'attrs': {}} only %}
		{% if page.featuredImage.url ?? false %}
			{% include 'image/Image.html.twig' with { src: page.featuredImage.url, alt: page.featuredImage.alt ?? '', class: kit('image', {}, 'aspect-[4/3] w-full rounded-xl object-cover'), loading: 'eager', decoding: 'async' } %}
		{% endif %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid items-center gap-8 overflow-hidden rounded-2xl bg-secondary p-8 md:grid-cols-2 md:p-16', 'children': c_ui6, 'attrs': {}} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 py-8 md:px-6', 'children': c_ui7, 'attrs': {}} only %}

{% set c_ui18 %}
	{% set c_ui17 %}
		{% set c_ui10 %}{% set c_ui8 %}{{ icon('truck', 'size-6') }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-primary', 'children': c_ui8, 'attrs': {}} only %}{% set c_ui9 %}{{ labels.free_shipping_over }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-sm', 'children': c_ui9, 'attrs': {}} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'li', 'class': 'flex items-center gap-4 rounded-xl border border-border bg-card p-4', 'children': c_ui10, 'attrs': {}} only %}
		{% set c_ui13 %}{% set c_ui11 %}{{ icon('rotate-ccw', 'size-6') }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-primary', 'children': c_ui11, 'attrs': {}} only %}{% set c_ui12 %}{{ labels.returns }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-sm', 'children': c_ui12, 'attrs': {}} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'li', 'class': 'flex items-center gap-4 rounded-xl border border-border bg-card p-4', 'children': c_ui13, 'attrs': {}} only %}
		{% set c_ui16 %}{% set c_ui14 %}{{ icon('shield-check', 'size-6') }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-primary', 'children': c_ui14, 'attrs': {}} only %}{% set c_ui15 %}{{ labels.pay_options }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-sm', 'children': c_ui15, 'attrs': {}} only %}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'li', 'class': 'flex items-center gap-4 rounded-xl border border-border bg-card p-4', 'children': c_ui16, 'attrs': {}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'ul', 'class': 'grid gap-4 md:grid-cols-3', 'children': c_ui17, 'attrs': {}} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 py-8 md:px-6', 'children': c_ui18, 'attrs': {}} only %}

{% if products ?? false %}
	{% set c_ui23 %}
		{% set c_ui21 %}
			{% set c_ui19 %}{{ labels.featured }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h2', 'class': 'text-2xl font-semibold tracking-tight md:text-3xl', 'children': c_ui19, 'attrs': {}} only %}
			{% set c_ui20 %}{{ labels.shop_now }}{{ icon('arrow-right') }}{% endset %}{% include 'link/Link.html.twig' with {'href': (((shop.url|safe_url)))|default(''), 'class': 'inline-flex items-center gap-2 text-sm font-medium text-primary no-underline', 'children': c_ui20, 'attrs': {}} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mb-8 flex items-end justify-between gap-4', 'children': c_ui21, 'attrs': {}} only %}
		{% set c_ui22 %}
			{% for product in products %}
				{% include 'blocks/product-card.html.twig' with { product: product, shop: shop, labels: labels } %}
			{% endfor %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6 lg:grid-cols-4', 'children': c_ui22, 'attrs': {}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'section', 'class': 'container mx-auto px-4 py-16 md:px-6', 'children': c_ui23, 'attrs': {}} only %}
{% endif %}
