{** Latte Shop — home: hero, perks, featured products. *}
{include 'blocks/notice.latte'}
{capture $c_ui7}
	{capture $c_ui6}
		{capture $c_ui5}
			{capture $c_ui1}{if !empty($page['title'])}{$page['title']}{else}{$site['title']}{/if}{/capture}{include 'text/Text.latte', tag: 'h1', class: 'text-4xl font-bold leading-tight tracking-tight text-secondary-foreground md:text-5xl', children: (string) $c_ui1, attrs: []}
			{if !empty($page['excerpt'])}{capture $c_ui2}{$page['excerpt']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-lg text-muted-foreground', children: (string) $c_ui2, attrs: []}{/if}
			{capture $c_ui4}{capture $c_ui3}{icon('shopping-bag')}{$labels['shop_now']}{/capture}{include 'link/Link.latte', href: ((($shop['url'])|checkUrl)) ?? '', class: 'inline-flex h-12 items-center gap-2 rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90', children: (string) $c_ui3, attrs: []}{/capture}{include 'box/Box.latte', tag: 'div', children: (string) $c_ui4, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-6', children: (string) $c_ui5, attrs: []}
		{if !empty($page['featuredImage']['url'])}
			{include 'image/Image.latte', src: $page['featuredImage']['url'], alt: $page['featuredImage']['alt'] ?? '', class: kit('image', [], 'aspect-[4/3] w-full rounded-xl object-cover'), loading: 'eager', decoding: 'async'}
		{/if}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'grid items-center gap-8 overflow-hidden rounded-2xl bg-secondary p-8 md:grid-cols-2 md:p-16', children: (string) $c_ui6, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 py-8 md:px-6', children: (string) $c_ui7, attrs: []}

{capture $c_ui18}
	{capture $c_ui17}
		{capture $c_ui10}{capture $c_ui8}{icon('truck', 'size-6')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-primary', children: (string) $c_ui8, attrs: []}{capture $c_ui9}{$labels['free_shipping_over']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm', children: (string) $c_ui9, attrs: []}{/capture}{include 'box/Box.latte', tag: 'li', class: 'flex items-center gap-4 rounded-xl border border-border bg-card p-4', children: (string) $c_ui10, attrs: []}
		{capture $c_ui13}{capture $c_ui11}{icon('rotate-ccw', 'size-6')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-primary', children: (string) $c_ui11, attrs: []}{capture $c_ui12}{$labels['returns']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm', children: (string) $c_ui12, attrs: []}{/capture}{include 'box/Box.latte', tag: 'li', class: 'flex items-center gap-4 rounded-xl border border-border bg-card p-4', children: (string) $c_ui13, attrs: []}
		{capture $c_ui16}{capture $c_ui14}{icon('shield-check', 'size-6')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-primary', children: (string) $c_ui14, attrs: []}{capture $c_ui15}{$labels['pay_options']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm', children: (string) $c_ui15, attrs: []}{/capture}{include 'box/Box.latte', tag: 'li', class: 'flex items-center gap-4 rounded-xl border border-border bg-card p-4', children: (string) $c_ui16, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'ul', class: 'grid gap-4 md:grid-cols-3', children: (string) $c_ui17, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 py-8 md:px-6', children: (string) $c_ui18, attrs: []}

{if !empty($products)}
	{capture $c_ui23}
		{capture $c_ui21}
			{capture $c_ui19}{$labels['featured']}{/capture}{include 'text/Text.latte', tag: 'h2', class: 'text-2xl font-semibold tracking-tight md:text-3xl', children: (string) $c_ui19, attrs: []}
			{capture $c_ui20}{$labels['shop_now']}{icon('arrow-right')}{/capture}{include 'link/Link.latte', href: ((($shop['url'])|checkUrl)) ?? '', class: 'inline-flex items-center gap-2 text-sm font-medium text-primary no-underline', children: (string) $c_ui20, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'mb-8 flex items-end justify-between gap-4', children: (string) $c_ui21, attrs: []}
		{capture $c_ui22}
			{foreach $products as $product}
				{include 'blocks/product-card.latte', product: $product, shop: $shop, labels: $labels}
			{/foreach}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6 lg:grid-cols-4', children: (string) $c_ui22, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 py-16 md:px-6', children: (string) $c_ui23, attrs: []}
{/if}
