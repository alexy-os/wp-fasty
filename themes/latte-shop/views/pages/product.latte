{** Latte Shop — single product. *}
{include 'blocks/notice.latte'}
{if $page}
<article class="{$page['post_class'] ?? ''} container mx-auto px-4 py-12 md:px-6">
	<nav class="mb-8 flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
		<a href="{$shop['url']}" class="text-muted-foreground no-underline hover:text-foreground">{$labels['all_products']}</a>
		{if !empty($page['product_cats'])}
			{icon('chevron-right')}
			<a href="{$page['product_cats'][0]['url']}" class="text-muted-foreground no-underline hover:text-foreground">{$page['product_cats'][0]['name']}</a>
		{/if}
	</nav>
	<div class="grid gap-8 md:grid-cols-2 md:gap-16">
		<div class="overflow-hidden rounded-2xl border border-border bg-muted">
			{if !empty($page['featuredImage']['url'])}
				{include 'image/Image.latte', src: $page['featuredImage']['url'], alt: $page['featuredImage']['alt'] ?? '', srcset: $page['featuredImage']['srcset'] ?? '', sizes: '(min-width: 768px) 50vw, 100vw', class: 'aspect-square h-full w-full object-cover', loading: 'eager'}
			{else}
				<div class="flex aspect-square items-center justify-center text-muted-foreground">{icon('package', 'size-8')}</div>
			{/if}
		</div>
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-4">
				<h1 class="text-3xl font-bold tracking-tight md:text-4xl">{$page['title']}</h1>
				<div class="flex items-baseline gap-4">
					<span class="text-3xl font-semibold">{$page['product']['price']}</span>
					{if $page['product']['regular']}<s class="text-lg text-muted-foreground">{$page['product']['regular']}</s>{/if}
					{if $page['product']['on_sale']}<span class="badge rounded-full bg-destructive px-2 py-1 text-xs font-semibold text-primary-foreground">{$labels['sale']}</span>{/if}
				</div>
				{if !empty($page['excerpt'])}<p class="text-muted-foreground">{$page['excerpt']}</p>{/if}
			</div>

			{if $page['product']['purchasable']}
				<form method="post" action="{$shop['action']}" class="flex flex-col gap-4 rounded-xl border border-border bg-card p-6">
					<input type="hidden" name="action" value="latte_shop_cart">
					<input type="hidden" name="op" value="add">
					<input type="hidden" name="product_id" value="{$page['id']}">
					<input type="hidden" name="_wpnonce" value="{$shop['cart_nonce']}">
					<div class="flex flex-col gap-2">
						{capture $qtyLabel}{$labels['qty']}{/capture}
						{include 'label/Label.latte', for: 'qty', children: (string) $qtyLabel}
						<div class="w-24">{include 'input/Input.latte', id: 'qty', type: 'number', name: 'qty', value: '1', min: '1', max: (string) ($page['product']['stock'] ?? 99), required: true}</div>
					</div>
					<div class="flex flex-wrap gap-4">
						{capture $addLabel}{icon('shopping-cart')}{$labels['add_to_cart']}{/capture}
						{include 'button/Button.latte', type: 'submit', size: 'lg', children: (string) $addLabel}
						{capture $buyLabel}{$labels['buy_now']}{/capture}
						{include 'button/Button.latte', type: 'submit', size: 'lg', variant: 'outline', attrs: ['name' => 'buy_now', 'value' => '1'], children: (string) $buyLabel}
					</div>
					{if $page['product']['stock'] !== null}
						<p class="text-sm text-muted-foreground">{$page['product']['stock']} in stock</p>
					{/if}
				</form>
			{else}
				{capture $oos}{$labels['out_of_stock']}{/capture}
				{include 'alert/Alert.latte', variant: 'destructive', class: 'px-4 py-2', children: (string) $oos}
			{/if}

			<ul class="flex flex-col gap-2 text-sm text-muted-foreground">
				<li class="flex items-center gap-2">{icon('truck')}Free shipping over {$shop['free_shipping']}</li>
				<li class="flex items-center gap-2">{icon('rotate-ccw')}30-day returns</li>
				{if !empty($page['product']['sku'])}<li class="flex items-center gap-2">{icon('tag')}SKU: {$page['product']['sku']}</li>{/if}
			</ul>

			<div class="prose max-w-none border-t border-border pt-6">{$page['content']|noescape}</div>
		</div>
	</div>
</article>
{/if}
