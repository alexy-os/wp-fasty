{** Latte Shop — single product. *}
{include 'blocks/notice.latte'}
{if $page}
{capture $c_ui24}
	{capture $c_ui3}
		{capture $c_ui1}{$labels['all_products']}{/capture}{include 'link/Link.latte', href: $shop['url'] ?? '', class: kit('link', ['variant' => 'muted', 'size' => 'sm']), children: (string) $c_ui1, attrs: []}
		{if !empty($page['product_cats'])}
			{icon('chevron-right')}
			{capture $c_ui2}{$page['product_cats'][0]['name']}{/capture}{include 'link/Link.latte', href: $page['product_cats'][0]['url'] ?? '', class: kit('link', ['variant' => 'muted', 'size' => 'sm']), children: (string) $c_ui2, attrs: []}
		{/if}
	{/capture}{include 'box/Box.latte', tag: 'nav', class: 'mb-8 flex items-center gap-2 text-sm text-muted-foreground', children: (string) $c_ui3, attrs: ['aria-label' => ($labels['breadcrumb'])]}
	{capture $c_ui23}
		{capture $c_ui5}
			{if !empty($page['featuredImage']['url'])}
				{include 'image/Image.latte', src: $page['featuredImage']['url'], alt: $page['featuredImage']['alt'] ?? '', sizes: '(min-width: 768px) 50vw, 100vw', class: kit('image', [], 'aspect-square h-full w-full object-cover'), loading: 'eager', srcSet: $page['featuredImage']['srcset'] ?? '', decoding: 'async'}
			{else}
				{capture $c_ui4}{icon('package', 'size-8')}{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex aspect-square items-center justify-center text-muted-foreground', children: (string) $c_ui4, attrs: []}
			{/if}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'overflow-hidden rounded-2xl border border-border bg-muted', children: (string) $c_ui5, attrs: []}
		{capture $c_ui22}
			{capture $c_ui11}
				{capture $c_ui6}{$page['title']}{/capture}{include 'text/Text.latte', tag: 'h1', class: 'text-3xl font-bold tracking-tight md:text-4xl', children: (string) $c_ui6, attrs: []}
				{capture $c_ui9}
					{capture $c_ui7}{$page['product']['price']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-3xl font-semibold', children: (string) $c_ui7, attrs: []}
					{if $page['product']['regular']}<s class="text-lg text-muted-foreground">{$page['product']['regular']}</s>{/if}
					{if $page['product']['on_sale']}{capture $c_ui8}{$labels['sale']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'badge rounded-full bg-destructive px-2 py-1 text-xs font-semibold text-primary-foreground', children: (string) $c_ui8, attrs: []}{/if}
				{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex items-baseline gap-4', children: (string) $c_ui9, attrs: []}
				{if !empty($page['excerpt'])}{capture $c_ui10}{$page['excerpt']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-muted-foreground', children: (string) $c_ui10, attrs: []}{/if}
			{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-4', children: (string) $c_ui11, attrs: []}

			{if $page['product']['purchasable']}
				{capture $c_ui16}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'action', 'value' => 'latte_shop_cart']}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'op', 'value' => 'add']}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'product_id', 'value' => ($page['id'])]}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => '_wpnonce', 'value' => ($shop['cart_nonce'])]}
					{capture $c_ui13}
						{capture $qtyLabel}{$labels['qty']}{/capture}
						{include 'label/Label.latte', htmlFor: 'qty', class: kit('label', []), children: (string) $qtyLabel}
						{capture $c_ui12}{include 'input/Input.latte', id: 'qty', type: 'number', name: 'qty', value: '1', min: '1', max: (string) ($page['product']['stock'] ?? 99), required: true, class: kit('input', [])}{/capture}{include 'box/Box.latte', tag: 'div', class: 'w-24', children: (string) $c_ui12, attrs: []}
					{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-2', children: (string) $c_ui13, attrs: []}
					{capture $c_ui14}
						{capture $addLabel}{icon('shopping-cart')}{$labels['add_to_cart']}{/capture}
						{include 'button/Button.latte', type: 'submit', class: kit('button', ['size' => 'lg'], 'gap-2'), children: (string) $addLabel}
						{capture $buyLabel}{$labels['buy_now']}{/capture}
						{include 'button/Button.latte', type: 'submit', attrs: ['name' => 'buy_now', 'value' => '1'], class: kit('button', ['variant' => 'outline', 'size' => 'lg']), children: (string) $buyLabel}
					{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-wrap gap-4', children: (string) $c_ui14, attrs: []}
					{if $page['product']['stock'] !== null}
						{capture $c_ui15}{$page['product']['stock']} in stock{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-sm text-muted-foreground', children: (string) $c_ui15, attrs: []}
					{/if}
				{/capture}{include 'form/Form.latte', action: $shop['action'] ?? '', class: 'flex flex-col gap-4 rounded-xl border border-border bg-card p-6', children: (string) $c_ui16, attrs: ['method' => 'post']}
			{elseif !empty($shop['enabled'])}
				{capture $oos}{$labels['out_of_stock']}{/capture}
				{include 'alert/Alert.latte', variant: 'destructive', children: (string) $oos}
			{/if}

			{capture $c_ui20}
				{capture $c_ui17}{icon('truck')}{$labels['free_shipping_over']}{/capture}{include 'box/Box.latte', tag: 'li', class: 'flex items-center gap-2', children: (string) $c_ui17, attrs: []}
				{capture $c_ui18}{icon('rotate-ccw')}30-day returns{/capture}{include 'box/Box.latte', tag: 'li', class: 'flex items-center gap-2', children: (string) $c_ui18, attrs: []}
				{if !empty($page['product']['sku'])}{capture $c_ui19}{icon('tag')}SKU: {$page['product']['sku']}{/capture}{include 'box/Box.latte', tag: 'li', class: 'flex items-center gap-2', children: (string) $c_ui19, attrs: []}{/if}
			{/capture}{include 'box/Box.latte', tag: 'ul', class: 'flex flex-col gap-2 text-sm text-muted-foreground', children: (string) $c_ui20, attrs: []}

			{capture $c_ui21}{$page['content']|noescape}{/capture}{include 'box/Box.latte', tag: 'div', class: 'prose max-w-none border-t border-border pt-6', children: (string) $c_ui21, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-6', children: (string) $c_ui22, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'grid gap-8 md:grid-cols-2 md:gap-16', children: (string) $c_ui23, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'article', class: (($page['post_class'] ?? '') . ' container mx-auto px-4 py-12 md:px-6'), children: (string) $c_ui24, attrs: []}
{/if}
