{# Flash notice after cart actions (Twig twin of notice.latte). Context: shop.notice #}
{% if shop.notice ?? false %}
	<div class="container mx-auto px-4 pt-8 md:px-6">
		{% set noticeBody %}<span class="inline-flex items-center gap-2">{{ icon(shop.notice.icon) }}{{ shop.notice.text }}</span>{% endset %}
		{% include 'alert/Alert.html.twig' with { variant: shop.notice.variant, role: 'status', ariaLive: 'polite', class: 'flex items-center px-4 py-2', children: noticeBody } %}
	</div>
{% endif %}
