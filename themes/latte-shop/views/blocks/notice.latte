{** Flash notice after cart actions. Context: shop.notice *}
{if !empty($shop['notice'])}
	<div class="container mx-auto px-4 pt-8 md:px-6">
		{capture $noticeBody}<span class="inline-flex items-center gap-2">{icon($shop['notice']['icon'])}{$shop['notice']['text']}</span>{/capture}
		{include 'alert/Alert.latte', variant: $shop['notice']['variant'], role: 'status', ariaLive: 'polite', class: 'flex items-center px-4 py-2', children: (string) $noticeBody}
	</div>
{/if}
