{
  "name": "latte-shop",
  "version": "1.0.0",
  "resources": [
    {
      "record": {
        "id": "media",
        "label": "Media",
        "scope": "global",
        "fields": [
          {
            "id": "title",
            "label": "Title",
            "type": "text",
            "localized": true
          },
          {
            "id": "alt",
            "label": "Alt",
            "type": "string"
          },
          {
            "id": "file",
            "label": "File",
            "type": "string",
            "required": true,
            "rules": [
              {
                "name": "fastygo.codex/uri"
              }
            ]
          },
          {
            "id": "height",
            "label": "Height",
            "type": "number",
            "rules": [
              {
                "name": "fastygo.codex/integer"
              }
            ]
          },
          {
            "id": "mime",
            "label": "Mime",
            "type": "string",
            "required": true
          },
          {
            "id": "width",
            "label": "Width",
            "type": "number",
            "rules": [
              {
                "name": "fastygo.codex/integer"
              }
            ]
          }
        ]
      }
    },
    {
      "record": {
        "id": "page",
        "label": "Pages",
        "scope": "global",
        "fields": [
          {
            "id": "title",
            "label": "Title",
            "type": "text",
            "localized": true
          },
          {
            "id": "content",
            "label": "Content",
            "type": "richtext",
            "localized": true
          },
          {
            "id": "excerpt",
            "label": "Excerpt",
            "type": "textarea",
            "localized": true
          },
          {
            "id": "author_id",
            "label": "Author",
            "type": "string",
            "ui_hint": "user"
          },
          {
            "id": "featured_media_id",
            "label": "Featured image",
            "type": "string",
            "ui_hint": "media"
          },
          {
            "id": "order",
            "label": "Order",
            "type": "number",
            "rules": [
              {
                "name": "fastygo.codex/integer"
              }
            ]
          },
          {
            "id": "published_at",
            "label": "Published",
            "type": "datetime"
          }
        ]
      }
    },
    {
      "record": {
        "id": "post",
        "label": "Posts",
        "scope": "global",
        "fields": [
          {
            "id": "title",
            "label": "Title",
            "type": "text",
            "localized": true
          },
          {
            "id": "content",
            "label": "Content",
            "type": "richtext",
            "localized": true
          },
          {
            "id": "excerpt",
            "label": "Excerpt",
            "type": "textarea",
            "localized": true
          },
          {
            "id": "author_id",
            "label": "Author",
            "type": "string",
            "ui_hint": "user"
          },
          {
            "id": "featured_media_id",
            "label": "Featured image",
            "type": "string",
            "ui_hint": "media"
          },
          {
            "id": "published_at",
            "label": "Published",
            "type": "datetime"
          }
        ]
      },
      "taxonomies": [
        "category",
        "post_tag"
      ]
    },
    {
      "record": {
        "id": "product",
        "label": "Products",
        "scope": "global",
        "fields": [
          {
            "id": "title",
            "label": "Title",
            "type": "text",
            "localized": true
          },
          {
            "id": "content",
            "label": "Content",
            "type": "richtext",
            "localized": true
          },
          {
            "id": "excerpt",
            "label": "Excerpt",
            "type": "textarea",
            "localized": true
          },
          {
            "id": "featured_media_id",
            "label": "Featured image",
            "type": "string",
            "ui_hint": "media"
          },
          {
            "id": "order",
            "label": "Order",
            "type": "number",
            "rules": [
              {
                "name": "fastygo.codex/integer"
              }
            ]
          },
          {
            "id": "published_at",
            "label": "Published",
            "type": "datetime"
          },
          {
            "id": "price",
            "label": "Price",
            "type": "number",
            "rules": [
              {
                "name": "fastygo.codex/money"
              }
            ],
            "required": true
          },
          {
            "id": "sale_price",
            "label": "Sale price",
            "type": "number",
            "rules": [
              {
                "name": "fastygo.codex/money"
              }
            ]
          },
          {
            "id": "sku",
            "label": "SKU",
            "type": "string"
          },
          {
            "id": "stock",
            "label": "Stock (empty = unlimited)",
            "type": "number",
            "rules": [
              {
                "name": "fastygo.codex/integer"
              }
            ]
          }
        ],
        "capabilities": [
          "purchasable"
        ]
      },
      "taxonomies": [
        "product_cat"
      ]
    },
    {
      "record": {
        "id": "user",
        "label": "Users",
        "scope": "global",
        "fields": [
          {
            "id": "title",
            "label": "Name",
            "type": "text",
            "localized": true
          },
          {
            "id": "display_name",
            "label": "Display name",
            "type": "string",
            "required": true
          }
        ]
      }
    }
  ]
}
