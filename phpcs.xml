<?xml version="1.0"?>
<ruleset name="WPFasty">
    <description>Coding standards for WP FastY Latte theme</description>

    <!-- Scan theme directory specifically -->
    <file>themes/latte</file>
    <file>themes/latte-press</file>
    <file>themes/latte-folio</file>
    <file>themes/latte-shop</file>
    <file>plugins/wpfasty-types</file>
    <file>plugins/wpfasty-builder</file>
    <file>tools/parity</file>
    <file>tools/qa</file>
    <arg name="extensions" value="php"/>

    <!-- Exclude directories and files -->
    <exclude-pattern>themes/latte/vendor/*</exclude-pattern>
    <exclude-pattern>themes/latte/node_modules/*</exclude-pattern>
    <exclude-pattern>themes/latte/assets/*/js/vendor/*</exclude-pattern>
    <exclude-pattern>themes/latte/~cache/*</exclude-pattern>
    <!-- UI8Kit 3 primitives installed by npx ui8kit@3 add all (third-party, verified by `ui8kit check`, never edited) -->
    <exclude-pattern>themes/latte/ui8kit/*</exclude-pattern>
    <exclude-pattern>themes/latte/twig/ui8kit/*</exclude-pattern>
    <exclude-pattern>.workspaces/*</exclude-pattern>
    <exclude-pattern>packages/*</exclude-pattern>
    <exclude-pattern>plugins/wpfasty-builder/sources/*</exclude-pattern>
    <exclude-pattern>plugins/wpfasty-builder/editor/*</exclude-pattern>
    
    <!-- Exclude all CSS files -->
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>**/*.css</exclude-pattern>
    <!-- exclude-pattern>themes/latte/style.css</exclude-pattern -->

    <!-- Choose one style: PSR2 -->
    <rule ref="PSR2">
        <!-- Allow short array syntax -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax.Found" />
    </rule>

    <!-- Include PSR4 for autoloading -->
    <rule ref="PSR1.Classes.ClassDeclaration"/>
    <rule ref="Squiz.Classes.ValidClassName"/>

    <!-- Setting the directory for PSR-4 checking -->
    <arg name="basepath" value="."/>
    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <properties>
            <property name="rootNamespaces" type="array">
                <element key="themes/latte/classes" value="WPFasty"/>
                <element key="plugins/wpfasty-types/src" value="WPFastyTypes"/>
                <element key="plugins/wpfasty-builder/src" value="WPFastyBuilder"/>
            </property>
        </properties>
        <!-- Child themes ship small inc/*.php files (no Composer autoload). -->
        <exclude-pattern>themes/latte-*/inc/*</exclude-pattern>
    </rule>

    <!-- Use LF line endings instead of CRLF -->
    <rule ref="Generic.Files.LineEndings">
        <properties>
            <property name="eolChar" value="\n"/>
        </properties>
    </rule>

    <!-- Configure DocBlock styles according to Symfony standards -->
    <rule ref="Squiz.Commenting.DocCommentAlignment"/>
    
    <!-- Configure trailing space handling -->
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
        <properties>
            <property name="ignoreBlankLines" value="false"/>
        </properties>
    </rule>
    
    <!-- Function documentation rules - Symfony style -->
    <rule ref="Squiz.Commenting.FunctionComment">
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamName"/>
        <exclude name="Squiz.Commenting.FunctionComment.EmptyThrows"/>
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingReturn"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentNotCapital"/>
        <exclude name="Squiz.Commenting.FunctionComment.ScalarTypeHintMissing"/>
        <!-- Squiz misreads single-line /** @param array<..> */ docblocks and generics -->
        <exclude name="Squiz.Commenting.FunctionComment.ParamNameNoMatch"/>
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
    </rule>
    
    <!-- Exclude redundant class comment rules -->
    <rule ref="Squiz.Commenting.ClassComment">
        <exclude name="Squiz.Commenting.ClassComment.TagNotAllowed"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
    </rule>
    
    <!-- Allow void returns to be documented or not -->
    <rule ref="Squiz.Commenting.FunctionComment.MissingReturn">
        <exclude-pattern>*\/void\s*\{</exclude-pattern>
    </rule>
    
    <!-- Fix for method trailing spaces -->
    <rule ref="Squiz.WhiteSpace.FunctionSpacing">
        <properties>
            <property name="spacing" value="1"/>
            <property name="spacingBeforeFirst" value="0"/>
            <property name="spacingAfterLast" value="0"/>
        </properties>
    </rule>

    <!-- Keep some important WordPress checks -->
    <rule ref="WordPress.WP.I18n" />
    <rule ref="WordPress.Security.EscapeOutput" />
    <rule ref="WordPress.Security.NonceVerification" />
    <rule ref="WordPress.WP.EnqueuedResources" />

    <!-- Configure text domains for internationalization -->
    <config name="text_domain" value="latte,latte-press,latte-folio,latte-shop,wpfasty-types,wpfasty-builder"/>

    <!-- Enable parallel processing -->
    <arg name="parallel" value="8" />
    
    <!-- Show colors in console -->
    <arg name="colors" />
    
    <!-- Show progress -->
    <arg value="p" />

    <!-- Add specific rules for Latte templates -->
    <rule ref="Internal.NoCodeFound">
        <!-- Don't report errors in .latte files -->
        <exclude-pattern>*.latte</exclude-pattern>
    </rule>

    <!-- Use PSR-11 for dependency injection -->
    <rule ref="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion" />
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint" />
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint" />
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <properties>
            <property name="enableObjectTypeHint" value="false"/>
            <property name="enableStaticTypeHint" value="false"/>
            <property name="enableMixedTypeHint" value="false"/>
            <property name="enableUnionTypeHint" value="false"/>
        </properties>
    </rule>

    <!-- PHP compatibility: release minimum (Requires PHP 8.2) up to the FrankenPHP runtime (8.5) -->
    <config name="testVersion" value="8.2-8.5"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Additional PHP 8 features -->
    <config name="php_version" value="80200" />
    <!-- Exception messages are never rendered as HTML -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <severity>0</severity>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingTraversableTypeHintSpecification"><severity>0</severity></rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingTraversableTypeHintSpecification"><severity>0</severity></rule>
</ruleset>