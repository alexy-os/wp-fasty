{# Latte Shop — header icon actions: search (mobile: opens the menu sheet with the search field), account, cart with live count (Twig twin of header-actions.latte). #}
{% set c_s %}{{ icon('search', 'size-5') }}{% endset %}{% include 'button/Button.html.twig' with {'class': kit('button', {'variant': 'outline', 'layout': 'icon'}, 'md:hidden'), 'children': c_s, 'attrs': {'type': 'button', 'data-ui8kit-dialog-open': 'true', 'data-ui8kit-dialog-target': sheet.panel|default(''), 'aria-controls': sheet.panel|default(''), 'aria-haspopup': 'dialog', 'data-ui8kit-dialog-focus': 'input[name=s]', 'aria-label': labels.search_site|default(labels.account_search|default(''))}} only %}
{% if shop.account_url|default('') %}{% set c_a %}{{ icon('user', 'size-5') }}{% endset %}{% include 'link/Link.html.twig' with {'href': shop.account_url, 'class': kit('button', {'variant': 'outline', 'layout': 'icon'}), 'children': c_a, 'attrs': {'aria-label': labels.account|default('')}} only %}{% endif %}
{% set c_ui2 %}
	{{ icon('shopping-bag', 'size-5') }}
	{% if shop.count > 0 %}
		{% set c_ui1 %}{{ shop.count }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': kit('badge', {'size': 'sm'}, 'absolute -right-2 -top-2'), 'children': c_ui1, 'attrs': {}} only %}
	{% endif %}
{% endset %}{% include 'link/Link.html.twig' with {'href': shop.cart_url|default(''), 'class': kit('button', {'variant': 'outline', 'layout': 'icon'}, 'relative'), 'children': c_ui2, 'attrs': {'aria-label': ((labels.cart) ~ ' (' ~ (shop.count) ~ ')')}} only %}
