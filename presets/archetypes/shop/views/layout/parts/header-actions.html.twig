{# Latte Shop — cart link with live count (Twig twin of header-actions.latte). #}
{% set c_ui2 %}
	{{ icon('shopping-bag', 'size-5') }}
	{% if shop.count > 0 %}
		{% set c_ui1 %}{{ shop.count }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'absolute -right-2 -top-2 badge inline-flex min-w-6 items-center justify-center rounded-full bg-primary px-2 text-xs font-semibold text-primary-foreground', 'children': c_ui1, 'attrs': {}} only %}
	{% endif %}
{% endset %}{% include 'link/Link.html.twig' with {'href': (((shop.cart_url|safe_url)))|default(''), 'class': 'relative inline-flex h-10 w-10 items-center justify-center rounded-md border border-border bg-background text-foreground no-underline hover:bg-accent', 'children': c_ui2, 'attrs': {'aria-label': ((labels.cart) ~ ' (' ~ (shop.count) ~ ')')}} only %}
