{# Latte Shop — cart (Twig twin of cart.latte). #}
{% include 'blocks/notice.html.twig' %}
<section class="container mx-auto px-4 py-12 md:px-6">
	<h1 class="mb-8 text-3xl font-bold tracking-tight">{{ labels.cart }}</h1>
	{% if not cart.items %}
		<div class="flex flex-col items-center gap-6 rounded-2xl border border-dashed border-border py-16 text-center">
			<span class="text-muted-foreground">{{ icon('shopping-cart', 'size-8') }}</span>
			<p class="text-muted-foreground">{{ labels.empty_cart }}</p>
			<a href="{{ shop.url|safe_url }}" class="inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground no-underline">{{ labels.continue_shopping }}</a>
		</div>
	{% else %}
		<div class="grid gap-8 lg:grid-cols-[1fr_360px]">
			<form method="post" action="{{ shop.action|safe_url }}" class="flex flex-col gap-4">
				<input type="hidden" name="action" value="latte_shop_cart">
				<input type="hidden" name="op" value="update">
				<input type="hidden" name="_wpnonce" value="{{ shop.cart_nonce }}">
				<ul class="flex flex-col divide-y divide-border rounded-xl border border-border bg-card">
					{% for item in cart.items %}
						<li class="flex items-center gap-4 p-4">
							{% if item.image %}<img src="{{ item.image|safe_url }}" alt="" class="size-16 rounded-lg object-cover" loading="lazy">{% else %}<span class="flex size-16 items-center justify-center rounded-lg bg-muted text-muted-foreground">{{ icon('package') }}</span>{% endif %}
							<div class="flex min-w-0 flex-1 flex-col gap-2">
								<a href="{{ item.url|safe_url }}" class="font-medium text-foreground no-underline hover:text-primary">{{ item.title }}</a>
								<span class="text-sm text-muted-foreground">{{ item.unit_display }}</span>
							</div>
							<label class="sr-only" for="qty-{{ item.id }}">{{ labels.qty }}</label>
							<div class="w-20 shrink-0">{% include 'input/Input.html.twig' with { id: 'qty-' ~ item.id, type: 'number', name: 'qtys[' ~ item.id ~ ']', value: item.qty ~ '', min: '0', max: '99', class: kit('input', {}) } %}</div>
							<span class="w-24 text-right font-semibold">{{ item.line_display }}</span>
							<button type="submit" form="remove-{{ item.id }}" class="inline-flex size-10 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-destructive" aria-label="{{ labels.remove }}: {{ item.title }}">{{ icon('trash-2') }}</button>
						</li>
					{% endfor %}
				</ul>
				<div class="flex flex-wrap justify-between gap-4">
					<a href="{{ shop.url|safe_url }}" class="inline-flex items-center gap-2 text-sm text-primary no-underline">{{ icon('arrow-left') }}{{ labels.continue_shopping }}</a>
					{% set upd %}{{ icon('rotate-ccw') }}{{ labels.update_cart }}{% endset %}
					{% include 'button/Button.html.twig' with { type: 'submit', class: kit('button', {'variant': 'outline'}), children: upd } %}
				</div>
			</form>
			{% for item in cart.items %}
				<form id="remove-{{ item.id }}" method="post" action="{{ shop.action|safe_url }}" hidden>
					<input type="hidden" name="action" value="latte_shop_cart">
					<input type="hidden" name="op" value="remove">
					<input type="hidden" name="product_id" value="{{ item.id }}">
					<input type="hidden" name="_wpnonce" value="{{ shop.cart_nonce }}">
				</form>
			{% endfor %}
			{% include 'blocks/order-summary.html.twig' with { cart: cart, labels: labels } %}
		</div>
	{% endif %}
</section>
