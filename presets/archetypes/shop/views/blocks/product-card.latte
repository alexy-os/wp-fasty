{** Latte Shop — product card. Params: $product (post view-model), $shop, $labels *}
{capture $c_ui13}
	{capture $c_ui3}
		{if !empty($product['featuredImage']['url'])}
			{include 'image/Image.latte', src: $product['featuredImage']['url'], alt: $product['featuredImage']['alt'] ?? '', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', class: kit('image', [], 'aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105'), loading: 'lazy', srcSet: $product['featuredImage']['srcset'] ?? '', decoding: 'async'}
		{else}
			{capture $c_ui1}{icon('package', 'size-8')}{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex aspect-square items-center justify-center text-muted-foreground', children: (string) $c_ui1, attrs: []}
		{/if}
		{if $product['product']['on_sale']}
			{capture $c_ui2}{$labels['sale']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'badge absolute left-4 top-4 rounded-full bg-destructive px-2 py-1 text-xs font-semibold text-primary-foreground', children: (string) $c_ui2, attrs: []}
		{/if}
	{/capture}{include 'link/Link.latte', href: ((($product['url'])|checkUrl)) ?? '', class: 'relative block overflow-hidden bg-muted no-underline', children: (string) $c_ui3, attrs: ['aria-label' => ($product['title'])]}
	{capture $c_ui12}
		{if !empty($product['product_cats'])}
			{capture $c_ui4}{$product['product_cats'][0]['name']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-xs uppercase tracking-wide text-muted-foreground', children: (string) $c_ui4, attrs: []}
		{/if}
		{capture $c_ui6}
			{capture $c_ui5}{$product['title']}{/capture}{include 'link/Link.latte', href: ((($product['url'])|checkUrl)) ?? '', class: 'text-foreground no-underline hover:text-primary', children: (string) $c_ui5, attrs: []}
		{/capture}{include 'text/Text.latte', tag: 'h3', class: 'font-semibold leading-tight', children: (string) $c_ui6, attrs: []}
		{capture $c_ui11}
			{capture $c_ui8}
				{capture $c_ui7}{$product['product']['price']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-lg font-semibold', children: (string) $c_ui7, attrs: []}
				{if $product['product']['regular']}<s class="text-sm text-muted-foreground">{$product['product']['regular']}</s>{/if}
			{/capture}{include 'text/Text.latte', tag: 'p', class: 'flex items-baseline gap-2', children: (string) $c_ui8, attrs: []}
			{if $product['product']['purchasable']}
				{capture $c_ui9}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'action', 'value' => 'latte_shop_cart']}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'op', 'value' => 'add']}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'product_id', 'value' => ($product['id'])]}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => '_wpnonce', 'value' => ($shop['cart_nonce'])]}
					{capture $addIcon}{icon('plus')}{/capture}
					{include 'button/Button.latte', type: 'submit', ariaLabel: $labels['add_to_cart'] . ': ' . $product['title'], class: kit('button', ['size' => 'icon']), children: (string) $addIcon}
				{/capture}{include 'form/Form.latte', action: ((($shop['action'])|checkUrl)) ?? '', children: (string) $c_ui9, attrs: ['method' => 'post']}
			{else}
				{capture $c_ui10}{$labels['out_of_stock']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-xs text-muted-foreground', children: (string) $c_ui10, attrs: []}
			{/if}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'mt-auto flex items-center justify-between gap-2 pt-2', children: (string) $c_ui11, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-1 flex-col gap-2 p-4', children: (string) $c_ui12, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'article', class: 'group flex flex-col overflow-hidden rounded-xl border border-border bg-card', children: (string) $c_ui13, attrs: []}
