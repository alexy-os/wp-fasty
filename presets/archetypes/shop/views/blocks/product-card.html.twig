{# Latte Shop — product card (Twig twin of product-card.latte). Params: product (post view-model), shop, labels #}
{% set c_ui13 %}
	{% set c_ui3 %}
		{% if product.featuredImage.url ?? false %}
			{% include 'image/Image.html.twig' with { src: product.featuredImage.url, alt: product.featuredImage.alt ?? '', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', class: kit('image', {}, 'aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105'), loading: 'lazy', srcSet: product.featuredImage.srcset ?? '', decoding: 'async' } %}
		{% else %}
			{% set c_ui1 %}{{ icon('package', 'size-8') }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex aspect-square items-center justify-center text-muted-foreground', 'children': c_ui1, 'attrs': {}} only %}
		{% endif %}
		{% if product.product.on_sale %}
			{% set c_ui2 %}{{ labels.sale }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'badge absolute left-4 top-4 rounded-full bg-destructive px-2 py-1 text-xs font-semibold text-primary-foreground', 'children': c_ui2, 'attrs': {}} only %}
		{% endif %}
	{% endset %}{% include 'link/Link.html.twig' with {'href': (((product.url|safe_url)))|default(''), 'class': 'relative block overflow-hidden bg-muted no-underline', 'children': c_ui3, 'attrs': {'aria-label': (product.title)}} only %}
	{% set c_ui12 %}
		{% if product.product_cats ?? false %}
			{% set c_ui4 %}{{ product.product_cats[0].name }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-xs uppercase tracking-wide text-muted-foreground', 'children': c_ui4, 'attrs': {}} only %}
		{% endif %}
		{% set c_ui6 %}
			{% set c_ui5 %}{{ product.title }}{% endset %}{% include 'link/Link.html.twig' with {'href': (((product.url|safe_url)))|default(''), 'class': 'text-foreground no-underline hover:text-primary', 'children': c_ui5, 'attrs': {}} only %}
		{% endset %}{% include 'text/Text.html.twig' with {'tag': 'h3', 'class': 'font-semibold leading-tight', 'children': c_ui6, 'attrs': {}} only %}
		{% set c_ui11 %}
			{% set c_ui8 %}
				{% set c_ui7 %}{{ product.product.price }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-lg font-semibold', 'children': c_ui7, 'attrs': {}} only %}
				{% if product.product.regular %}<s class="text-sm text-muted-foreground">{{ product.product.regular }}</s>{% endif %}
			{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'flex items-baseline gap-2', 'children': c_ui8, 'attrs': {}} only %}
			{% if product.product.purchasable %}
				{% set c_ui9 %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'action', 'value': 'latte_shop_cart'}} only %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'op', 'value': 'add'}} only %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'product_id', 'value': (product.id)}} only %}
					{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': '_wpnonce', 'value': (shop.cart_nonce)}} only %}
					{% set addIcon %}{{ icon('plus') }}{% endset %}
					{% include 'button/Button.html.twig' with { type: 'submit', ariaLabel: labels.add_to_cart ~ ': ' ~ product.title, class: kit('button', {'size': 'icon'}), children: addIcon } %}
				{% endset %}{% include 'form/Form.html.twig' with {'action': (((shop.action|safe_url)))|default(''), 'children': c_ui9, 'attrs': {'method': 'post'}} only %}
			{% else %}
				{% set c_ui10 %}{{ labels.out_of_stock }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-xs text-muted-foreground', 'children': c_ui10, 'attrs': {}} only %}
			{% endif %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mt-auto flex items-center justify-between gap-2 pt-2', 'children': c_ui11, 'attrs': {}} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-1 flex-col gap-2 p-4', 'children': c_ui12, 'attrs': {}} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'article', 'class': 'group flex flex-col overflow-hidden rounded-xl border border-border bg-card', 'children': c_ui13, 'attrs': {}} only %}
