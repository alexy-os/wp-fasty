{**
 * Latte Press — editorial post list (thumbnail + category + excerpt).
 * Context: posts[], pagination, labels
 *}
{capture $list}
	{if empty($posts)}
		{capture $c_ui1}{$labels['no_posts'] ?? 'No posts found.'}{/capture}{include 'text/Text.latte', tag: 'p', class: 'py-16 text-center text-muted-foreground', children: (string) $c_ui1, attrs: []}
	{else}
		{capture $items}
			{foreach $posts as $post}
				{capture $c_ui13}
					{if !empty($post['thumbnail']['url'])}
						{capture $thumb}
							{include 'image/Image.latte', src: $post['thumbnail']['url'], alt: $post['thumbnail']['alt'] ?? '', sizes: '(min-width: 768px) 240px, 100vw', class: kit('image', [], 'aspect-[4/3] w-full rounded-lg object-cover'), loading: 'lazy', srcSet: $post['thumbnail']['srcset'] ?? '', decoding: 'async'}
						{/capture}
						{include 'link/Link.latte', href: $post['url'], class: kit('link', ['variant' => 'block']), ariaLabel: (string) $post["title"], children: (string) $thumb}
					{else}
						{include 'box/Box.latte', tag: 'div', class: 'hidden md:block', attrs: []}
					{/if}
					{capture $c_ui12}
						{if !empty($post['categories'])}
							{capture $c_ui3}
								{foreach $post['categories'] as $cat}
									{capture $c_ui2}{$cat['name']}{/capture}{include 'link/Link.latte', href: $cat['url'] ?? '', class: kit('link', ['size' => 'sm'], 'uppercase tracking-wide'), children: (string) $c_ui2, attrs: []}
								{/foreach}
							{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-wrap gap-2', children: (string) $c_ui3, attrs: []}
						{/if}
						{capture $c_ui5}
							{capture $c_ui4}{$post['title']}{/capture}{include 'link/Link.latte', href: $post['url'] ?? '', class: 'text-foreground no-underline hover:text-primary', children: (string) $c_ui4, attrs: []}
						{/capture}{include 'text/Text.latte', tag: 'h2', class: 'text-2xl font-semibold leading-tight', children: (string) $c_ui5, attrs: []}
						{capture $c_ui9}
							{if !empty($post['date']['display'])}
								{capture $c_ui7}{icon('calendar')}{capture $c_ui6}{$post['date']['display']}{/capture}{include 'text/Text.latte', tag: 'time', children: (string) $c_ui6, attrs: ['datetime' => ($post['date']['iso'] ?? '')]}{/capture}{include 'text/Text.latte', tag: 'span', class: 'inline-flex items-center gap-2', children: (string) $c_ui7, attrs: []}
							{/if}
							{if !empty($post['author']['name'])}
								{capture $c_ui8}{icon('user')}{$post['author']['name']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'inline-flex items-center gap-2', children: (string) $c_ui8, attrs: []}
							{/if}
						{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-wrap items-center gap-4 text-sm text-muted-foreground', children: (string) $c_ui9, attrs: []}
						{if !empty($post['excerpt'])}
							{capture $c_ui10}{$post['excerpt']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-muted-foreground', children: (string) $c_ui10, attrs: []}
						{/if}
						{capture $c_ui11}{$labels['read_more'] ?? 'Read more'}{icon('arrow-right')}{/capture}{include 'link/Link.latte', href: $post['url'] ?? '', class: kit('link', ['size' => 'sm']), children: (string) $c_ui11, attrs: []}
					{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-2', children: (string) $c_ui12, attrs: []}
				{/capture}{include 'box/Box.latte', tag: 'article', class: (($post['post_class'] ?? '') . ' grid gap-6 border-b border-border pb-8 md:grid-cols-[240px_1fr]'), children: (string) $c_ui13, attrs: []}
			{/foreach}
		{/capture}
		{include 'stack/Stack.latte', gap: '8', children: (string) $items}
	{/if}

	{if !empty($pagination)}
		{capture $c_ui17}
			{if $pagination['prev_url']}
				{capture $c_ui14}{icon('arrow-left')}{$labels['previous'] ?? 'Previous'}{/capture}{include 'link/Link.latte', href: $pagination['prev_url'] ?? '', class: kit('link', ['size' => 'sm']), children: (string) $c_ui14, attrs: []}
			{/if}
			{capture $c_ui15}{$pagination['current']} / {$pagination['total']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm text-muted-foreground', children: (string) $c_ui15, attrs: []}
			{if $pagination['next_url']}
				{capture $c_ui16}{$labels['next'] ?? 'Next'}{icon('arrow-right')}{/capture}{include 'link/Link.latte', href: $pagination['next_url'] ?? '', class: kit('link', ['size' => 'sm']), children: (string) $c_ui16, attrs: []}
			{/if}
		{/capture}{include 'box/Box.latte', tag: 'nav', class: 'mt-10 flex items-center justify-center gap-4', children: (string) $c_ui17, attrs: ['aria-label' => ($labels['pagination'] ?? 'Pagination')]}
	{/if}
{/capture}

{capture $box}
	{include 'box/Box.latte', class: 'container mx-auto px-4 py-12 md:px-6', children: (string) $list}
{/capture}
{include 'block/Block.latte', tag: 'section', children: (string) $box}
