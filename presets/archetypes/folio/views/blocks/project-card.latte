{**
 * Folio — project card. Params: $project (post view-model), $labels
 *}
{capture $c_ui9}
	{capture $c_ui2}
		{if !empty($project['featuredImage']['url'])}
			{include 'image/Image.latte', src: $project['featuredImage']['url'], alt: $project['featuredImage']['alt'] ?? '', sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw', class: kit('image', [], 'aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105'), loading: 'lazy', srcSet: $project['featuredImage']['srcset'] ?? '', decoding: 'async'}
		{else}
			{capture $c_ui1}{icon('image', 'size-8')}{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex aspect-[4/3] items-center justify-center text-muted-foreground', children: (string) $c_ui1, attrs: []}
		{/if}
	{/capture}{include 'link/Link.latte', href: $project['url'] ?? '', class: 'block overflow-hidden rounded-xl border border-border bg-card no-underline', children: (string) $c_ui2, attrs: ['aria-label' => ($project['title'])]}
	{capture $c_ui8}
		{capture $c_ui6}
			{capture $c_ui4}
				{capture $c_ui3}{$project['title']}{/capture}{include 'link/Link.latte', href: $project['url'] ?? '', class: 'text-foreground no-underline hover:text-primary', children: (string) $c_ui3, attrs: []}
			{/capture}{include 'text/Text.latte', tag: ($headingTag ?? 'h3'), class: 'text-lg font-semibold leading-tight', children: (string) $c_ui4, attrs: []}
			{if !empty($project['types'])}
				{capture $c_ui5}
					{foreach $project['types'] as $type}
						{capture $typeName}{$type['name']}{/capture}{include 'badge/Badge.latte', variant: 'secondary', children: (string) $typeName}
					{/foreach}
				{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-wrap gap-2', children: (string) $c_ui5, attrs: []}
			{/if}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col gap-2', children: (string) $c_ui6, attrs: []}
		{if !empty($project['project']['year']['value'])}
			{capture $c_ui7}{$project['project']['year']['value']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm text-muted-foreground', children: (string) $c_ui7, attrs: []}
		{/if}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex items-start justify-between gap-4', children: (string) $c_ui8, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'article', class: 'group flex flex-col gap-4', children: (string) $c_ui9, attrs: []}
