{** WP FastY — header actions: cart with live count. *}
{capture $cartIcon}
	{icon('shopping-cart', 'size-5')}
	{if $shop['count'] > 0}
		{capture $cnt}{$shop['count']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'badge absolute -right-2 -top-2 inline-flex min-w-6 items-center justify-center rounded-full bg-primary px-2 text-xs font-semibold text-primary-foreground', children: (string) $cnt, attrs: []}
	{/if}
{/capture}{include 'link/Link.latte', href: $shop['cart_url'] ?? '', class: 'relative inline-flex size-10 items-center justify-center rounded-lg border border-border bg-card text-foreground no-underline hover:border-primary hover:text-primary', children: (string) $cartIcon, attrs: ['aria-label' => (($labels['cart']) . ' (' . ($shop['count']) . ')')]}
