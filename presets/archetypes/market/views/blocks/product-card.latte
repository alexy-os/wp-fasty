{** WP FastY — item card. Params: $product (view-model with digital fixtures), $shop, $labels *}
{var $d = $product['digital'] ?? []}
{capture $card}
	{capture $thumb}
		{if !empty($product['featuredImage']['url'])}
			{include 'image/Image.latte', src: $product['featuredImage']['url'], alt: $product['featuredImage']['alt'] ?? '', sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw', class: kit('image', [], 'aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105'), loading: 'lazy', srcSet: $product['featuredImage']['srcset'] ?? '', decoding: 'async'}
		{else}
			{capture $ph}{icon('layers', 'size-8')}{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex aspect-video items-center justify-center text-muted-foreground', children: (string) $ph, attrs: []}
		{/if}
		{if !empty($product['badge']) || $product['product']['on_sale']}
			{capture $bd}{if !empty($product['badge'])}{$product['badge']}{else}{$labels['sale']}{/if}{/capture}{include 'text/Text.latte', tag: 'span', class: 'badge absolute left-4 top-4 rounded-md bg-primary px-2 py-1 text-xs font-semibold uppercase tracking-wide text-primary-foreground', children: (string) $bd, attrs: []}
		{/if}
	{/capture}{include 'link/Link.latte', href: $product['url'] ?? '', class: 'relative block overflow-hidden border-b border-border bg-muted no-underline', children: (string) $thumb, attrs: ['aria-label' => ($product['title'])]}
	{capture $body}
		{capture $meta}
			{if !empty($product['product_cats'])}{capture $c}{$product['product_cats'][0]['name']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'font-medium text-primary', children: (string) $c, attrs: []}{/if}
			{if !empty($d['version'])}{capture $c}v{$d['version']}{/capture}{include 'text/Text.latte', tag: 'span', children: (string) $c, attrs: []}{/if}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex items-center justify-between text-xs text-muted-foreground', children: (string) $meta, attrs: []}
		{capture $ttl}{capture $t}{$product['title']}{/capture}{include 'link/Link.latte', href: $product['url'] ?? '', class: 'text-foreground no-underline hover:text-primary', children: (string) $t, attrs: []}{/capture}{include 'text/Text.latte', tag: ($headingTag ?? 'h3'), class: 'font-heading text-base font-semibold leading-snug', children: (string) $ttl, attrs: []}
		{if !empty($d['author'])}
			{capture $by}{$labels['by']} {capture $an}{$d['author']['name']}{/capture}{include 'link/Link.latte', href: $d['author']['url'] ?? '', class: 'text-muted-foreground underline-offset-4 hover:text-foreground hover:underline', children: (string) $an, attrs: []}{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-sm text-muted-foreground', children: (string) $by, attrs: []}
		{/if}
		{capture $stats}
			{capture $r}{icon('star', 'size-4 text-primary')}{number_format($product['rating'] ?? 0, 1)} ({$product['reviews'] ?? 0}){/capture}{include 'text/Text.latte', tag: 'span', class: 'inline-flex items-center gap-2', children: (string) $r, attrs: []}
			{capture $s}{$d['sales'] ?? 0} {$labels['sales']}{/capture}{include 'text/Text.latte', tag: 'span', children: (string) $s, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex items-center justify-between text-xs text-muted-foreground', children: (string) $stats, attrs: []}
		{capture $foot}
			{capture $pr}
				{capture $p}{$product['product']['price']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'font-heading text-xl font-bold', children: (string) $p, attrs: []}
				{if $product['product']['regular']}<s class="text-sm text-muted-foreground">{$product['product']['regular']}</s>{/if}
			{/capture}{include 'text/Text.latte', tag: 'p', class: 'flex items-baseline gap-2', children: (string) $pr, attrs: []}
			{capture $acts}
				{if !empty($d['preview_url'])}
					{capture $eye}{icon('eye', 'size-4')}{/capture}{include 'link/Link.latte', href: $d['preview_url'], class: 'inline-flex size-10 items-center justify-center rounded-lg border border-border text-foreground no-underline hover:border-primary hover:text-primary', children: (string) $eye, attrs: ['aria-label' => (($labels['live_preview']) . ': ' . ($product['title'])), 'target' => '_blank', 'rel' => 'noopener']}
				{/if}
				{if $product['product']['purchasable']}
					{capture $f}
						{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'action', 'value' => 'wpfasty_market_cart']}
						{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'op', 'value' => 'add']}
						{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'product_id', 'value' => ($product['id'])]}
						{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => '_wpnonce', 'value' => ($shop['cart_nonce'])]}
						{capture $addIcon}{icon('shopping-cart', 'size-4')}{/capture}
						{include 'button/Button.latte', type: 'submit', ariaLabel: $labels['add_to_cart'] . ': ' . $product['title'], class: kit('button', ['size' => 'icon'], 'rounded-lg'), children: (string) $addIcon}
					{/capture}{include 'form/Form.latte', action: $shop['action'] ?? '', children: (string) $f, attrs: ['method' => 'post']}
				{/if}
			{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex items-center gap-2', children: (string) $acts, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'mt-auto flex items-center justify-between gap-2 border-t border-border pt-4', children: (string) $foot, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-1 flex-col gap-2 p-4', children: (string) $body, attrs: []}
{/capture}{include 'box/Box.latte', tag: 'article', class: 'group flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-colors hover:border-primary', children: (string) $card, attrs: []}
