{** WP FastY — cookie banner: hidden until JS finds no consent; "Accept all" / "Necessary only" / policy link. *}
{capture $box}
	{capture $t}{icon('shield-check', 'size-5 shrink-0 text-primary')}{capture $tx}{$labels['cookie_text']}{/capture}{include 'text/Text.latte', tag: 'span', children: (string) $tx, attrs: []}{/capture}{include 'text/Text.latte', tag: 'p', class: 'flex flex-1 gap-2 text-sm', children: (string) $t, attrs: []}
	{capture $acts}
		{capture $a}{$labels['cookie_accept']}{/capture}{include 'button/Button.latte', type: 'button', class: kit('button', [], 'rounded-lg font-semibold'), children: (string) $a, attrs: ['data-cookie' => 'all']}
		{capture $n}{$labels['cookie_necessary']}{/capture}{include 'button/Button.latte', type: 'button', class: kit('button', ['variant' => 'outline'], 'rounded-lg'), children: (string) $n, attrs: ['data-cookie' => 'necessary']}
		{capture $s}{$labels['legal_cookies']}{/capture}{include 'link/Link.latte', href: $legalUrls['cookies'] ?? '', class: kit('button', ['variant' => 'ghost'], 'rounded-lg no-underline'), children: (string) $s, attrs: []}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-wrap gap-2', children: (string) $acts, attrs: []}
{/capture}
{capture $inner}{include 'box/Box.latte', tag: 'div', class: 'container mx-auto flex flex-col gap-4 rounded-xl border border-border bg-card p-4 text-card-foreground shadow-lg md:flex-row md:items-center', children: (string) $box, attrs: []}{/capture}
{include 'box/Box.latte', tag: 'div', class: 'fixed inset-x-0 bottom-0 z-50 px-4 pb-4', children: (string) $inner, attrs: ['id' => 'cookie-banner', 'role' => 'region', 'aria-label' => ($labels['cookie_settings']), 'hidden' => true]}
