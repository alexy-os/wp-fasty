{** WP FastY — catalog search (GET, product post type). Params: $shop, $labels, $size ('lg' | 'default') *}
{capture $f}
	{capture $lbl}{$labels['search']}{/capture}{include 'label/Label.latte', htmlFor: 'market-search', class: 'sr-only', children: (string) $lbl}
	{capture $field}
		{capture $ic}{icon('search', 'size-5')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground', children: (string) $ic, attrs: []}
		{include 'input/Input.latte', id: 'market-search', type: 'search', name: 's', value: (string) ($search['query'] ?? ''), class: kit('input', [], 'h-14 rounded-xl border-transparent bg-card pl-12 pr-32 text-base text-card-foreground'), attrs: ['placeholder' => ($labels['search_placeholder'])]}
		{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'post_type', 'value' => 'product']}
		{capture $go}{$labels['search']}{/capture}{include 'button/Button.latte', type: 'submit', class: kit('button', [], 'absolute right-2 top-2 h-10 rounded-lg px-6 font-semibold'), children: (string) $go}
	{/capture}{include 'box/Box.latte', tag: 'div', class: 'relative', children: (string) $field, attrs: []}
{/capture}{include 'form/Form.latte', action: $shop['search_url'] ?? '', class: 'w-full max-w-2xl', children: (string) $f, attrs: ['method' => 'get', 'role' => 'search']}
