{# Flash notice after cart actions. Context: shop.notice #}
{% if not ((shop['notice']) is empty) %}
	{% set c_ui2 %}
		{% set noticeBody %}{% set c_ui1 %}{{ icon(shop['notice']['icon']) }}{{ shop['notice']['text'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex items-center gap-2', 'children': c_ui1, 'attrs': []} only %}{% endset %}
		{% include 'alert/Alert.html.twig' with {'variant': shop['notice']['variant'], 'role': 'status', 'ariaLive': 'polite', 'class': 'flex items-center px-4 py-2', 'children': noticeBody} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'container mx-auto px-4 pt-8 md:px-6', 'children': c_ui2, 'attrs': []} only %}
{% endif %}
