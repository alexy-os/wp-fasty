{# WP FastY — item card. Params: $product (view-model with digital fixtures), $shop, $labels #}
{% set d = product['digital'] ?? [] %}
{% set card %}
	{% set thumb %}
		{% if not ((product['featuredImage']['url']) is empty) %}
			{% include 'image/Image.html.twig' with {'src': product['featuredImage']['url'], 'alt': product['featuredImage']['alt'] ?? '', 'sizes': '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw', 'class': kit('image', [], 'aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105'), 'loading': 'lazy', 'srcSet': product['featuredImage']['srcset'] ?? '', 'decoding': 'async'} only %}
		{% else %}
			{% set ph %}{{ icon('layers', 'size-8') }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex aspect-video items-center justify-center text-muted-foreground', 'children': ph, 'attrs': []} only %}
		{% endif %}
		{% if not ((product['badge']) is empty) or product['product']['on_sale'] %}
			{% set bd %}{% if not ((product['badge']) is empty) %}{{ product['badge'] }}{% else %}{{ labels['sale'] }}{% endif %}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'badge absolute left-4 top-4 rounded-md bg-primary px-2 py-1 text-xs font-semibold uppercase tracking-wide text-primary-foreground', 'children': bd, 'attrs': []} only %}
		{% endif %}
	{% endset %}{% include 'link/Link.html.twig' with {'href': product['url'] ?? '', 'class': 'relative block overflow-hidden border-b border-border bg-muted no-underline', 'children': thumb, 'attrs': {'aria-label': (product['title'])}} only %}
	{% set body %}
		{% set meta %}
			{% if not ((product['product_cats']) is empty) %}{% set c %}{{ product['product_cats'][0]['name'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'font-medium text-primary', 'children': c, 'attrs': []} only %}{% endif %}
			{% if not ((d['version']) is empty) %}{% set c %}v{{ d['version'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'children': c, 'attrs': []} only %}{% endif %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex items-center justify-between text-xs text-muted-foreground', 'children': meta, 'attrs': []} only %}
		{% set ttl %}{% set t %}{{ product['title'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': product['url'] ?? '', 'class': 'text-foreground no-underline hover:text-primary', 'children': t, 'attrs': []} only %}{% endset %}{% include 'text/Text.html.twig' with {'tag': (headingTag ?? 'h3'), 'class': 'font-heading text-base font-semibold leading-snug', 'children': ttl, 'attrs': []} only %}
		{% if not ((d['author']) is empty) %}
			{% set by %}{{ labels['by'] }} {% set an %}{{ d['author']['name'] }}{% endset %}{% include 'link/Link.html.twig' with {'href': d['author']['url'] ?? '', 'class': 'text-muted-foreground underline-offset-4 hover:text-foreground hover:underline', 'children': an, 'attrs': []} only %}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': by, 'attrs': []} only %}
		{% endif %}
		{% set stats %}
			{% set r %}{{ icon('star', 'size-4 text-primary') }}{{ ((product['rating'] ?? 0)|number_format(1, '.', ',')) }} ({{ product['reviews'] ?? 0 }}){% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'inline-flex items-center gap-2', 'children': r, 'attrs': []} only %}
			{% set s %}{{ d['sales'] ?? 0 }} {{ labels['sales'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'children': s, 'attrs': []} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex items-center justify-between text-xs text-muted-foreground', 'children': stats, 'attrs': []} only %}
		{% set foot %}
			{% set pr %}
				{% set p %}{{ product['product']['price'] }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'font-heading text-xl font-bold', 'children': p, 'attrs': []} only %}
				{% if product['product']['regular'] %}<s class="text-sm text-muted-foreground">{{ product['product']['regular'] }}</s>{% endif %}
			{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'flex items-baseline gap-2', 'children': pr, 'attrs': []} only %}
			{% set acts %}
				{% if not ((d['preview_url']) is empty) %}
					{% set eye %}{{ icon('eye', 'size-4') }}{% endset %}{% include 'link/Link.html.twig' with {'href': d['preview_url'], 'class': 'inline-flex size-10 items-center justify-center rounded-lg border border-border text-foreground no-underline hover:border-primary hover:text-primary', 'children': eye, 'attrs': {'aria-label': ((labels['live_preview']) ~ ': ' ~ (product['title'])), 'target': '_blank', 'rel': 'noopener'}} only %}
				{% endif %}
				{% if product['product']['purchasable'] and not ((shop['cart_available']) is empty) %}
					{% set f %}
						{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'action', 'value': 'latte_shop_cart'}} only %}
						{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'op', 'value': 'add'}} only %}
						{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': 'product_id', 'value': (product['id'])}} only %}
						{% include 'input/Input.html.twig' with {'attrs': {'type': 'hidden', 'name': '_wpnonce', 'value': (shop['cart_nonce'])}} only %}
						{% set addIcon %}{{ icon('shopping-cart', 'size-4') }}{% endset %}
						{% include 'button/Button.html.twig' with {'type': 'submit', 'ariaLabel': labels['add_to_cart'] ~ ': ' ~ product['title'], 'class': kit('button', {'size': 'icon'}, 'rounded-lg'), 'children': addIcon} only %}
					{% endset %}{% include 'form/Form.html.twig' with {'action': shop['action'] ?? '', 'children': f, 'attrs': {'method': 'post'}} only %}
				{% endif %}
			{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex items-center gap-2', 'children': acts, 'attrs': []} only %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'mt-auto flex items-center justify-between gap-2 border-t border-border pt-4', 'children': foot, 'attrs': []} only %}
	{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'flex flex-1 flex-col gap-2 p-4', 'children': body, 'attrs': []} only %}
{% endset %}{% include 'box/Box.html.twig' with {'tag': 'article', 'class': 'group flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-colors hover:border-primary', 'children': card, 'attrs': []} only %}
