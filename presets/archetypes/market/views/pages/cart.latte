{** WP FastY — cart. *}
{include 'blocks/notice.latte'}
{capture $c_ui21}
	{capture $c_ui1}{$labels['cart']}{/capture}{include 'text/Text.latte', tag: 'h1', class: 'mb-8 font-heading text-3xl font-extrabold tracking-tight', children: (string) $c_ui1, attrs: []}
	{if empty($shop['cart_available'])}
		{include 'blocks/unavailable.latte'}
	{elseif empty($cart['items'])}
		{capture $c_ui5}
			{capture $c_ui2}{icon('shopping-cart', 'size-8')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-muted-foreground', children: (string) $c_ui2, attrs: []}
			{capture $c_ui3}{$labels['empty_cart']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'text-muted-foreground', children: (string) $c_ui3, attrs: []}
			{capture $c_ui4}{$labels['continue_shopping']}{/capture}{include 'link/Link.latte', href: $shop['url'] ?? '', class: 'inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground no-underline', children: (string) $c_ui4, attrs: []}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-col items-center gap-6 rounded-2xl border border-dashed border-border py-16 text-center', children: (string) $c_ui5, attrs: []}
	{else}
		{capture $c_ui20}
			{capture $c_ui18}
				{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'action', 'value' => 'latte_shop_cart']}
				{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'op', 'value' => 'update']}
				{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => '_wpnonce', 'value' => ($shop['cart_nonce'])]}
				{capture $c_ui15}
					{foreach $cart['items'] as $item}
						{capture $c_ui14}
							{if $item['image']}{include 'image/Image.latte', src: $item['image'] ?? '', class: 'size-16 rounded-lg object-cover', attrs: ['alt' => '', 'loading' => 'lazy']}{else}{capture $c_ui6}{icon('package')}{/capture}{include 'text/Text.latte', tag: 'span', class: 'flex size-16 items-center justify-center rounded-lg bg-muted text-muted-foreground', children: (string) $c_ui6, attrs: []}{/if}
							{capture $c_ui9}
								{capture $c_ui7}{$item['title']}{/capture}{include 'link/Link.latte', href: $item['url'] ?? '', class: 'font-medium text-foreground no-underline hover:text-primary', children: (string) $c_ui7, attrs: []}
								{if !empty($item['tier_label'])}{capture $tl}{$labels['license_tier']}: {$item['tier_label']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-xs font-semibold uppercase tracking-widest text-primary', children: (string) $tl, attrs: []}{/if}
								{capture $c_ui8}{$item['unit_display']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm text-muted-foreground', children: (string) $c_ui8, attrs: []}
							{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex min-w-0 flex-1 flex-col gap-2', children: (string) $c_ui9, attrs: []}
							{capture $c_ui10}{$labels['qty']}{/capture}{include 'label/Label.latte', class: 'sr-only', children: (string) $c_ui10, attrs: ['for' => ('qty-' . $iterator->counter)]}
							{capture $c_ui11}{include 'input/Input.latte', id: 'qty-' . $iterator->counter, type: 'number', name: 'qtys[' . ($item['key'] ?? $item['id']) . ']', value: (string) $item['qty'], min: '0', max: '99', class: kit('input', [])}{/capture}{include 'box/Box.latte', tag: 'div', class: 'w-20 shrink-0', children: (string) $c_ui11, attrs: []}
							{capture $c_ui12}{$item['line_display']}{/capture}{include 'text/Text.latte', tag: 'span', class: 'w-24 text-right font-semibold', children: (string) $c_ui12, attrs: []}
							{capture $c_ui13}{icon('trash-2')}{/capture}{include 'button/Button.latte', class: 'inline-flex size-10 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-destructive', children: (string) $c_ui13, attrs: ['type' => 'submit', 'form' => ('remove-' . $iterator->counter), 'aria-label' => (($labels['remove']) . ': ' . ($item['title']))]}
						{/capture}{include 'box/Box.latte', tag: 'li', class: 'flex items-center gap-4 p-4', children: (string) $c_ui14, attrs: []}
					{/foreach}
				{/capture}{include 'box/Box.latte', tag: 'ul', class: 'flex flex-col divide-y divide-border rounded-xl border border-border bg-card', children: (string) $c_ui15, attrs: []}
				{capture $c_ui17}
					{capture $c_ui16}{icon('arrow-left')}{$labels['continue_shopping']}{/capture}{include 'link/Link.latte', href: $shop['url'] ?? '', class: 'inline-flex items-center gap-2 text-sm text-primary no-underline', children: (string) $c_ui16, attrs: []}
					{capture $upd}{icon('rotate-ccw')}{$labels['update_cart']}{/capture}
					{include 'button/Button.latte', type: 'submit', class: kit('button', ['variant' => 'outline']), children: (string) $upd}
				{/capture}{include 'box/Box.latte', tag: 'div', class: 'flex flex-wrap justify-between gap-4', children: (string) $c_ui17, attrs: []}
			{/capture}{include 'form/Form.latte', action: $shop['action'] ?? '', class: 'flex flex-col gap-4 lg:col-span-2', children: (string) $c_ui18, attrs: ['method' => 'post']}
			{foreach $cart['items'] as $item}
				{capture $c_ui19}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'action', 'value' => 'latte_shop_cart']}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'op', 'value' => 'remove']}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'product_id', 'value' => ($item['id'])]}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => 'key', 'value' => ($item['key'] ?? $item['id'])]}
					{include 'input/Input.latte', attrs: ['type' => 'hidden', 'name' => '_wpnonce', 'value' => ($shop['cart_nonce'])]}
				{/capture}{include 'form/Form.latte', action: $shop['action'] ?? '', children: (string) $c_ui19, attrs: ['id' => ('remove-' . $iterator->counter), 'method' => 'post', 'hidden' => true]}
			{/foreach}
			{include 'blocks/order-summary.latte', cart: $cart, labels: $labels}
		{/capture}{include 'box/Box.latte', tag: 'div', class: 'grid gap-8 lg:grid-cols-3', children: (string) $c_ui20, attrs: []}
	{/if}
{/capture}{include 'box/Box.latte', tag: 'section', class: 'container mx-auto px-4 py-12 md:px-6', children: (string) $c_ui21, attrs: []}
