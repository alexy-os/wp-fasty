{#
 # Block: post / page content (Twig twin of post-content.latte)
 # Context: page, labels
 #}
{% if page %}
	{% set meta %}
		{% if (page.date.display ?? false) or (page.author ?? false) or (page.categories ?? false) %}
			{% set metaBits %}
				{% if page.date.display ?? false %}
					{% set c_ui2 %}{{ labels.posted_on }} {% set c_ui1 %}{{ page.date.display }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'time', 'children': c_ui1, 'attrs': {'datetime': (page.date.iso ?? '')}} only %}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'children': c_ui2, 'attrs': {}} only %}
				{% endif %}
				{% if page.author.name ?? false %}
					{% set authorName %}{{ page.author.name }}{% endset %}
					{% set c_ui3 %}{{ labels.by_author }}
						{% include 'link/Link.html.twig' with { href: page.author.url, class: kit('link', {'variant': 'muted', 'size': 'sm'}), children: authorName } %}
					{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'children': c_ui3, 'attrs': {}} only %}
				{% endif %}
				{% if page.categories ?? false %}
					{% set c_ui4 %}{{ labels.categories }}:
						{% for cat in page.categories %}
							{% set catName %}{{ cat.name }}{% endset %}
							{% include 'link/Link.html.twig' with { href: cat.url, class: kit('link', {'variant': 'muted', 'size': 'sm'}), children: catName } %}{% if not loop.last %}, {% endif %}
						{% endfor %}
					{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'children': c_ui4, 'attrs': {}} only %}
				{% endif %}
			{% endset %}
			{% include 'group/Group.html.twig' with { class: 'mb-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted-foreground', children: metaBits } %}
		{% endif %}
	{% endset %}

	{% set inner %}
		{% set titleHtml %}{{ page.title }}{% endset %}
		{% include 'title/Title.html.twig' with { as: 1, size: '3xl', weight: 'bold', class: 'mb-6 tracking-tight md:text-4xl', children: titleHtml } %}

		{{ meta }}

		{% if page.featuredImage.url ?? false %}
			{% set img %}
				{% include 'image/Image.html.twig' with {
					src: page.featuredImage.url,
					alt: page.featuredImage.alt ?? '',
					width: (page.featuredImage.width ?? '') ~ '',
					height: (page.featuredImage.height ?? '') ~ '',
					sizes: page.featuredImage.sizes ?? '',
					class: kit('image', {}, 'w-full'),
					loading: 'eager',
					srcSet: page.featuredImage.srcset ?? '',
					decoding: 'async'
				} %}
			{% endset %}
			{% include 'box/Box.html.twig' with { class: 'mb-8 overflow-hidden rounded-lg', children: img } %}
		{% endif %}

		{% set body %}{% set c_ui5 %}{{ page.content|raw }}{% endset %}{% include 'box/Box.html.twig' with {'tag': 'div', 'class': 'prose max-w-none text-foreground', 'children': c_ui5, 'attrs': {}} only %}{% endset %}
		{% include 'box/Box.html.twig' with { children: body } %}

		{% if page.link_pages ?? false %}
			{{ page.link_pages|raw }}
		{% endif %}

		{% if page.tags ?? false %}
			{% set tagBits %}
				{% set c_ui6 %}{{ labels.tags }}:{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-sm text-muted-foreground', 'children': c_ui6, 'attrs': {}} only %}
				{% for tag in page.tags %}
					{% set tagName %}{{ tag.name }}{% endset %}
					{% set tagLink %}{% include 'link/Link.html.twig' with { href: tag.url, class: kit('link', {'size': 'sm'}), children: tagName } %}{% endset %}
					{% include 'badge/Badge.html.twig' with { variant: 'secondary', children: tagLink } %}
				{% endfor %}
			{% endset %}
			{% include 'group/Group.html.twig' with { class: 'mt-8 flex flex-wrap items-center gap-2', children: tagBits } %}
		{% endif %}

		{% if (page.prev ?? false) or (page.next ?? false) %}
			{% set navBits %}
				{% if page.prev.url ?? false %}
					{% set prevLabel %}{{ labels.previous_post }}: {{ page.prev.title }}{% endset %}
					{% include 'link/Link.html.twig' with { href: page.prev.url, class: kit('link', {'size': 'sm'}), children: prevLabel } %}
				{% endif %}
				{% if page.next.url ?? false %}
					{% set nextLabel %}{{ labels.next_post }}: {{ page.next.title }}{% endset %}
					{% include 'link/Link.html.twig' with { href: page.next.url, class: kit('link', {'size': 'sm'}), children: nextLabel } %}
				{% endif %}
			{% endset %}
			{% include 'group/Group.html.twig' with { class: 'mt-10 flex flex-wrap justify-between gap-4 border-t border-border pt-8', children: navBits } %}
		{% endif %}
	{% endset %}

	{% set box %}
		{% include 'box/Box.html.twig' with { class: 'container mx-auto max-w-3xl px-4 py-12 md:px-6', children: inner } %}
	{% endset %}
	{% include 'block/Block.html.twig' with { tag: 'article', class: page.post_class ?? '', children: box } %}
{% endif %}
