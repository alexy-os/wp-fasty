{**
 * Block: hero-centered — UI8Kit Link CTAs.
 * Context: site, hero
 *}
{capture $heroInner}
	{capture $titleHtml}{$site['title']}{/capture}
	{include 'title/Title.latte', as: 1, size: '4xl', weight: 'bold', class: 'tracking-tight md:text-5xl', children: (string) $titleHtml}

	{if !empty($site['description'])}
		{capture $descHtml}{capture $c_ui1}{$site['description']}{/capture}{include 'text/Text.latte', tag: 'p', class: 'mt-4 text-lg text-muted-foreground', children: (string) $c_ui1, attrs: []}{/capture}
		{$descHtml}
	{/if}

	{capture $actions}
		{capture $explore}{$hero['primaryLabel'] ?? 'Explore'}{/capture}
		{capture $learn}{$hero['secondaryLabel'] ?? 'Learn more'}{/capture}
		{if !empty($hero['primaryUrl'])}
			{capture $primary}
				{include 'link/Link.latte', href: $hero['primaryUrl'], class: kit('button', []), children: (string) $explore}
			{/capture}
			{$primary}
		{/if}
		{if !empty($hero['secondaryUrl'])}
			{capture $secondary}
				{include 'link/Link.latte', href: $hero['secondaryUrl'], class: kit('button', ['variant' => 'secondary']), children: (string) $learn}
			{/capture}
			{$secondary}
		{/if}
	{/capture}
	{include 'group/Group.latte', class: 'mt-8 flex flex-wrap justify-center gap-4', children: (string) $actions}
{/capture}

{capture $heroBox}
	{include 'box/Box.latte', class: 'mx-auto max-w-3xl text-center', children: (string) $heroInner}
{/capture}

{include 'block/Block.latte', tag: 'section', class: 'bg-muted py-16 md:py-24', children: (string) $heroBox}
