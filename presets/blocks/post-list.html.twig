{#
 # Block: post-list (Twig twin of post-list.latte)
 # Context: posts[], pagination, labels
 #}
{% set list %}
	{% if not posts %}
		{% set c_ui1 %}{{ labels.no_posts ?? 'No posts found.' }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'py-16 text-center text-muted-foreground', 'children': c_ui1, 'attrs': {}} only %}
	{% else %}
		{% set cards %}
			{% for post in posts %}
				{% set body %}
					{% set postTitle %}{{ post.title }}{% endset %}
					{% set t %}{% include 'link/Link.html.twig' with { href: post.url, class: kit('link', {}), children: postTitle } %}{% endset %}
					{% set h %}{% include 'card/CardTitle.html.twig' with { children: t } %}{% endset %}
					{% include 'card/CardHeader.html.twig' with { children: h } %}
					{% if post.excerpt ?? false %}
						{% set ex %}{% set c_ui2 %}{{ post.excerpt }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'p', 'class': 'text-sm text-muted-foreground', 'children': c_ui2, 'attrs': {}} only %}{% endset %}
						{% include 'card/CardContent.html.twig' with { children: ex } %}
					{% endif %}
					{% if post.date.display ?? false %}
						{% set ft %}{% set c_ui3 %}{{ post.date.display }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'time', 'class': 'text-xs text-muted-foreground', 'children': c_ui3, 'attrs': {'datetime': (post.date.iso ?? '')}} only %}{% endset %}
						{% include 'card/CardFooter.html.twig' with { children: ft } %}
					{% endif %}
				{% endset %}
				{% include 'card/Card.html.twig' with { variant: 'compact', class: post.post_class ?? '', children: body } %}
			{% endfor %}
		{% endset %}
		{% include 'stack/Stack.html.twig' with { gap: '6', children: cards } %}
	{% endif %}

	{% if pagination ?? false %}
		{% set c_ui5 %}
			{% if pagination.prev_url %}
				{% set prevL %}{{ labels.previous ?? 'Previous' }}{% endset %}
				{% include 'link/Link.html.twig' with { href: pagination.prev_url, class: kit('link', {'size': 'sm'}), children: prevL } %}
			{% endif %}
			{% set c_ui4 %}{{ pagination.current }} / {{ pagination.total }}{% endset %}{% include 'text/Text.html.twig' with {'tag': 'span', 'class': 'text-sm text-muted-foreground', 'children': c_ui4, 'attrs': {}} only %}
			{% if pagination.next_url %}
				{% set nextL %}{{ labels.next ?? 'Next' }}{% endset %}
				{% include 'link/Link.html.twig' with { href: pagination.next_url, class: kit('link', {'size': 'sm'}), children: nextL } %}
			{% endif %}
		{% endset %}{% include 'box/Box.html.twig' with {'tag': 'nav', 'class': 'mt-10 flex justify-center gap-4', 'children': c_ui5, 'attrs': {'aria-label': (labels.pagination ?? 'Pagination')}} only %}
	{% endif %}
{% endset %}

{% set box %}
	{% include 'box/Box.html.twig' with { class: 'container mx-auto px-4 py-12 md:px-6', children: list } %}
{% endset %}
{% include 'block/Block.html.twig' with { tag: 'section', children: box } %}
