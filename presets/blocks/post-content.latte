{**
 * Block: post / page content
 * Context: page, labels
 *}
{if $page}
	{capture $meta}
		{if !empty($page['date']['display']) || !empty($page['author']) || !empty($page['categories'])}
			{capture $metaBits}
				{if !empty($page['date']['display'])}
					{capture $c_ui2}{$labels['posted_on']} {capture $c_ui1}{$page['date']['display']}{/capture}{include 'text/Text.latte', tag: 'time', children: (string) $c_ui1, attrs: ['datetime' => ($page['date']['iso'] ?? '')]}{/capture}{include 'text/Text.latte', tag: 'span', children: (string) $c_ui2, attrs: []}
				{/if}
				{if !empty($page['author']['name'])}
					{capture $authorName}{$page['author']['name']}{/capture}
					{capture $c_ui3}{$labels['by_author']}
						{include 'link/Link.latte', href: $page['author']['url'], class: kit('link', ['variant' => 'muted', 'size' => 'sm']), children: (string) $authorName}
					{/capture}{include 'text/Text.latte', tag: 'span', children: (string) $c_ui3, attrs: []}
				{/if}
				{if !empty($page['categories'])}
					{capture $c_ui4}{$labels['categories']}:
						{foreach $page['categories'] as $cat}
							{capture $catName}{$cat['name']}{/capture}
							{include 'link/Link.latte', href: $cat['url'], class: kit('link', ['variant' => 'muted', 'size' => 'sm']), children: (string) $catName}{if !$iterator->last}, {/if}
						{/foreach}
					{/capture}{include 'text/Text.latte', tag: 'span', children: (string) $c_ui4, attrs: []}
				{/if}
			{/capture}
			{include 'group/Group.latte', class: 'mb-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted-foreground', children: (string) $metaBits}
		{/if}
	{/capture}

	{capture $inner}
		{capture $titleHtml}{$page['title']}{/capture}
		{include 'title/Title.latte', as: 1, size: '3xl', weight: 'bold', class: 'mb-6 tracking-tight md:text-4xl', children: (string) $titleHtml}

		{$meta|noescape}

		{if !empty($page['featuredImage']['url'])}
			{capture $img}
				{include 'image/Image.latte',
					src: $page['featuredImage']['url'],
					alt: $page['featuredImage']['alt'] ?? '',
					width: (string) ($page['featuredImage']['width'] ?? ''),
					height: (string) ($page['featuredImage']['height'] ?? ''),
					sizes: $page['featuredImage']['sizes'] ?? '',
					class: kit('image', [], 'w-full'),
					loading: 'eager',
					srcSet: $page['featuredImage']['srcset'] ?? '',
					decoding: 'async'
				}
			{/capture}
			{include 'box/Box.latte', class: 'mb-8 overflow-hidden rounded-lg', children: (string) $img}
		{/if}

		{capture $body}{capture $c_ui5}{$page['content']|noescape}{/capture}{include 'box/Box.latte', tag: 'div', class: 'prose max-w-none text-foreground', children: (string) $c_ui5, attrs: []}{/capture}
		{include 'box/Box.latte', children: (string) $body}

		{if !empty($page['link_pages'])}
			{$page['link_pages']|noescape}
		{/if}

		{if !empty($page['tags'])}
			{capture $tagBits}
				{capture $c_ui6}{$labels['tags']}:{/capture}{include 'text/Text.latte', tag: 'span', class: 'text-sm text-muted-foreground', children: (string) $c_ui6, attrs: []}
				{foreach $page['tags'] as $tag}
					{capture $tagName}{$tag['name']}{/capture}
					{capture $tagLink}{include 'link/Link.latte', href: $tag['url'], class: kit('link', ['size' => 'sm']), children: (string) $tagName}{/capture}
					{include 'badge/Badge.latte', variant: 'secondary', children: (string) $tagLink}
				{/foreach}
			{/capture}
			{include 'group/Group.latte', class: 'mt-8 flex flex-wrap items-center gap-2', children: (string) $tagBits}
		{/if}

		{if !empty($page['prev']) || !empty($page['next'])}
			{capture $navBits}
				{if !empty($page['prev']['url'])}
					{capture $prevLabel}{$labels['previous_post']}: {$page['prev']['title']}{/capture}
					{include 'link/Link.latte', href: $page['prev']['url'], class: kit('link', ['size' => 'sm']), children: (string) $prevLabel}
				{/if}
				{if !empty($page['next']['url'])}
					{capture $nextLabel}{$labels['next_post']}: {$page['next']['title']}{/capture}
					{include 'link/Link.latte', href: $page['next']['url'], class: kit('link', ['size' => 'sm']), children: (string) $nextLabel}
				{/if}
			{/capture}
			{include 'group/Group.latte', class: 'mt-10 flex flex-wrap justify-between gap-4 border-t border-border pt-8', children: (string) $navBits}
		{/if}
	{/capture}

	{capture $box}
		{include 'box/Box.latte', class: 'container mx-auto max-w-3xl px-4 py-12 md:px-6', children: (string) $inner}
	{/capture}
	{include 'block/Block.latte', tag: 'article', class: $page['post_class'] ?? '', children: (string) $box}
{/if}
