{**
 * App shell — sidebar + header + mobile sheet.
 * Context: site, content, menu
 *}
<html lang="{$site['lang']}">
<head>
	<meta charset="{$site['charset'] ?? 'UTF-8'}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	{wp_head}
</head>
<body {body_class 'font-sans bg-background antialiased'}>
	<a class="skip-link screen-reader-text" href="#content">Skip to content</a>

	{include 'parts/mobile-sheet.latte'}

	<div class="flex min-h-screen items-stretch">
		{include 'parts/sidebar.latte'}

		<div class="flex min-w-0 flex-1 flex-col">
			{include 'parts/header.latte'}

			<main id="content" class="site-content flex-1">
				{do_action 'before_content'}
				{$content|noescape}
				{do_action 'after_content'}
			</main>

			{include 'parts/footer.latte'}
		</div>
	</div>

	{wp_footer}
</body>
</html>
