{
    // Mutation testing of the pure layers: Core (container, application kernel, models, Cast) and the ViewModel
    // builders (WPFasty\Data\*). ContextFactory is the WordPress-side facade (Adapter layer in deptrac) and stays out.
    // Run: composer infection (needs pcov or xdebug). CI: the `mutation` job.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "themes/latte/classes/Core",
            "themes/latte/classes/Data"
        ],
        "excludes": [
            "ContextFactory.php"
        ]
    },
    "phpUnit": {
        "configDir": "."
    },
    "tmpDir": "var/cache/infection",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 95,
    "minCoveredMsi": 95
}
