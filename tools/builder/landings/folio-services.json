          "action": {
            "label": "See the work",
            "href": "{archive:project}"
          }
        }
      },
      {
        "id": "process",
        "block": "steps",
        "variant": "row",
        "props": {
          "title": "How a project runs",
          "steps": [
            {
              "id": "step-call",
              "title": "Intro call",
              "text": "We talk about the goal, the audience and the timeline.",
