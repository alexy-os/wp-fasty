{
    "name": "alexy-os/wp-fasty",
    "description": "WP FastY monorepo — PHPUnit, PHPStan, Deptrac, PHPCS (Symfony) and PHP-CS-Fixer tooling",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "deptrac/deptrac": "^3.0",
        "escapestudios/symfony2-coding-standard": "^3.13",
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.32.6",
        "opis/json-schema": "^2.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.8",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "twig/twig": "^3.14",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "WPFasty\\Tests\\": "tests/",
            "WPFastyBuilder\\": "plugins/wpfasty-builder/src/",
            "WPFastyTypes\\Codex\\": "plugins/wpfasty-types/src/Codex/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "infection/extension-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": [
            "@php -r \"is_dir('var/cache') || mkdir('var/cache', 0777, true);\"",
            "phpcs"
        ],
        "phpcbf": [
            "@php -r \"is_dir('var/cache') || mkdir('var/cache', 0777, true);\"",
            "phpcbf"
        ],
        "phpstan": "phpstan analyse --configuration=phpstan.dist.neon --memory-limit=1G",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
        "cs": [
            "php-cs-fixer check --config=.php-cs-fixer.dist.php",
            "@phpcs"
        ],
        "cs-fix": [
            "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
            "@php -r \"is_dir('var/cache') || mkdir('var/cache', 0777, true);\"",
            "phpcbf || exit 0"
        ],
        "infection": "infection --no-progress",
        "rector": "rector process --dry-run --no-progress-bar",
        "rector:fix": "rector process --no-progress-bar",
        "qa": [
            "@phpstan",
            "@deptrac",
            "@cs",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "infection": "Mutation testing of Core + ViewModel builders (infection.json5, needs pcov or xdebug)",
        "rector": "Rector dry-run (rector.php: PHP 8.2 set + dead code, code quality, early return)",
        "rector:fix": "Apply the Rector changes",
        "phpcs": "PHPCS: Symfony standard + WordPress security (phpcs.xml.dist), blocking",
        "phpstan": "Static analysis (level 8 + baseline)",
        "deptrac": "Architecture layers (blocking)",
        "cs": "Coding standard check, blocking: PHP-CS-Fixer @Symfony dry-run + PHPCS",
        "cs-fix": "Apply PHP-CS-Fixer @Symfony, then phpcbf",
        "qa": "phpstan + deptrac + cs + test",
        "phpcbf": "PHPCBF over phpcs.xml.dist"
    }
}
