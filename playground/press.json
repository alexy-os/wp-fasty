{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.5",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "login",
      "username": "admin"
    },
    {
      "step": "writeFile",
      "path": "/tmp/wp-fasty.zip",
      "data": {
        "resource": "url",
        "url": "https://wordpress-playground-cors-proxy.net/?https://github.com/alexy-os/wp-fasty/releases/download/playground/wp-fasty.zip"
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/latte-press.zip",
      "data": {
        "resource": "url",
        "url": "https://wordpress-playground-cors-proxy.net/?https://github.com/alexy-os/wp-fasty/releases/download/playground/latte-press.zip"
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/demo.zip",
      "data": {
        "resource": "url",
        "url": "https://wordpress-playground-cors-proxy.net/?https://github.com/alexy-os/wp-fasty/releases/download/playground/demo.zip"
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/wpfasty-types.zip",
      "data": {
        "resource": "url",
        "url": "https://wordpress-playground-cors-proxy.net/?https://github.com/alexy-os/wp-fasty/releases/download/playground/wpfasty-types.zip"
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/wpfasty-builder.zip",
      "data": {
        "resource": "url",
        "url": "https://wordpress-playground-cors-proxy.net/?https://github.com/alexy-os/wp-fasty/releases/download/playground/wpfasty-builder.zip"
      }
    },
    {
      "step": "unzip",
      "zipPath": "/tmp/wp-fasty.zip",
      "extractToPath": "/wordpress/wp-content/themes"
    },
    {
      "step": "unzip",
      "zipPath": "/tmp/latte-press.zip",
      "extractToPath": "/wordpress/wp-content/themes"
    },
    {
      "step": "unzip",
      "zipPath": "/tmp/demo.zip",
      "extractToPath": "/wordpress/wp-content"
    },
    {
      "step": "unzip",
      "zipPath": "/tmp/wpfasty-types.zip",
      "extractToPath": "/wordpress/wp-content/plugins"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "wpfasty-types/wpfasty-types.php"
    },
    {
      "step": "unzip",
      "zipPath": "/tmp/wpfasty-builder.zip",
      "extractToPath": "/wordpress/wp-content/plugins"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "wpfasty-builder/wpfasty-builder.php"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "latte-press"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/wpfasty-demo/press.php'; flush_rewrite_rules();"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; $files = glob('/wordpress/wp-content/wpfasty-demo/landings/press*.json'); usort($files, static fn ($a, $b) => strlen($a) <=> strlen($b)); foreach ($files as $f) { $r = WPFastyBuilder\\Seeder::landing(json_decode(file_get_contents($f), true)); if (is_wp_error($r)) { throw new Exception(basename($f) . ': ' . $r->get_error_message()); } }"
    }
  ]
}
