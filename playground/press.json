{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "login",
      "username": "admin"
    },
    {
      "step": "writeFile",
      "path": "/tmp/latte.zip.b64",
      "data": {
        "resource": "url",
        "url": "https://gist.githubusercontent.com/alexy-os/ce9f531eeb05bb8aee9dadcd3b0c1ecc/raw/latte.zip.b64"
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/latte-press.zip.b64",
      "data": {
        "resource": "url",
        "url": "https://gist.githubusercontent.com/alexy-os/ce9f531eeb05bb8aee9dadcd3b0c1ecc/raw/latte-press.zip.b64"
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/demo.zip.b64",
      "data": {
        "resource": "url",
        "url": "https://gist.githubusercontent.com/alexy-os/ce9f531eeb05bb8aee9dadcd3b0c1ecc/raw/demo.zip.b64"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php foreach (glob('/tmp/*.zip.b64') as $f) { file_put_contents(substr($f, 0, -4), base64_decode(file_get_contents($f))); }"
    },
    {
      "step": "unzip",
      "zipPath": "/tmp/latte.zip",
      "extractToPath": "/wordpress/wp-content/themes"
    },
    {
      "step": "unzip",
      "zipPath": "/tmp/latte-press.zip",
      "extractToPath": "/wordpress/wp-content/themes"
    },
    {
      "step": "unzip",
      "zipPath": "/tmp/demo.zip",
      "extractToPath": "/wordpress/wp-content"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "latte-press"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/wpfasty-demo/press.php'; flush_rewrite_rules();"
    }
  ]
}