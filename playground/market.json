      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; wp_set_current_user(1); $files = glob('/wordpress/wp-content/wpfasty-demo/landings/market*.json'); usort($files, static fn ($a, $b) => strlen($a) <=> strlen($b)); foreach ($files as $f) { $r = WPFastyBuilder\\Seeder::landing(json_decode(file_get_contents($f), true)); if (is_wp_error($r)) { throw new Exception(basename($f) . ': ' . $r->get_error_message()); } } flush_rewrite_rules();"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; wp_set_current_user(1);\n// Demo buyer: one paid order, then verified reviews (rating 1-5) on the products it contains.\n$email = 'buyer@example.com';\n$reviews = ['fasty-agency' => [5, 'Анна', 'Поставила за вечер, демо-контент импортировался без ошибок.'], 'latte-magazine' => [5, 'Игорь', 'Быстрая тема, PageSpeed 98 из коробки.'], 'fasty-seo' => [4, 'Мария', 'Всё нужное есть, хотелось бы больше настроек схемы.']];\n$items = [];\nforeach (array_keys($reviews) as $slug) { $p = get_page_by_path($slug, OBJECT, 'product'); if ($p) { $items[] = ['id' => $p->ID, 'title' => $p->post_title, 'sku' => strtoupper($slug), 'qty' => 1, 'unit' => 0, 'line' => 0, 'tier' => 'regular', 'tier_label' => 'Обычная', 'digital' => true]; } }\n$order = wp_insert_post(['post_type' => 'shop_order', 'post_status' => 'private', 'post_title' => 'Demo order']);\nforeach (['_order_name' => 'Demo Buyer', '_order_email' => $email, '_order_items' => $items, '_order_status' => 'paid', '_order_payment' => 'card'] as $k => $v) { update_post_meta($order, $k, $v); }\nforeach ($reviews as $slug => [$rating, $name, $text]) { $p = get_page_by_path($slug, OBJECT, 'product'); if (!$p) { continue; } $c = wp_insert_comment(['comment_post_ID' => $p->ID, 'comment_author' => $name, 'comment_author_email' => $email, 'comment_content' => $text, 'comment_approved' => 1, 'comment_type' => 'comment']); update_comment_meta($c, 'rating', $rating); update_comment_meta($c, 'verified', 1); if (class_exists('PhpFasty\\\\Module\\\\Reviews\\\\Reviews')) { PhpFasty\\Module\\Reviews\\Reviews::recount($p->ID); } }"
