{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/godudy/wpfasty/docs/agent/schema/theme-manifest.schema.json",
  "title": "wpfasty theme manifest (draft 0.1)",
  "description": "Input for external generation (web form, CLI, MCP): produces parent + child theme.",
  "type": "object",
  "required": ["version", "theme", "engine"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "0.1" },
    "engine": { "enum": ["latte", "twig"], "default": "latte" },
    "theme": {
      "type": "object",
      "required": ["name", "slug", "author"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{3,39}$", "description": "Also the text domain; >=4 chars (wp.org prefix rule)." },
        "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]{3,19}$" },
        "author": { "type": "string" },
        "authorUri": { "type": "string", "format": "uri" },
        "themeUri": { "type": "string", "format": "uri" },
        "description": { "type": "string", "maxLength": 500 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$", "default": "1.0.0" },
        "requiresWp": { "type": "string", "default": "6.5" },
        "testedUpTo": { "type": "string" },
        "requiresPhp": { "type": "string", "default": "8.1" },
        "license": { "const": "GPL-2.0-or-later" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "preset": { "enum": ["press", "folio", "shop", "blank"], "default": "press" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius": { "type": "string", "pattern": "^(0|\\d+(\\.\\d+)?rem)$" },
        "fontSans": { "type": "string" },
        "fontHeading": { "type": "string" },
        "light": { "$ref": "#/$defs/tokens" },
        "dark": { "$ref": "#/$defs/tokens" }
      }
    },
    "postTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/postType" }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wporg": { "type": "boolean", "default": false, "description": "If true, post types are emitted as a companion plugin (ADR-001 §3a)." },
        "includeDemo": { "type": "boolean", "default": true }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|oklch\\([^)]+\\)|hsl\\([^)]+\\))$" },
    "tokens": {
      "type": "object",
      "description": "shadcn-compatible token names (without --).",
      "additionalProperties": false,
      "patternProperties": {
        "^(background|foreground|card|card-foreground|popover|popover-foreground|primary|primary-foreground|secondary|secondary-foreground|muted|muted-foreground|accent|accent-foreground|destructive|destructive-foreground|border|input|ring)$": { "$ref": "#/$defs/color" }
      }
    },
    "field": {
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "text", "url", "integer", "money", "boolean", "date"] },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "default": {}
      }
    },
    "postType": {
      "type": "object",
      "required": ["name", "singular", "plural"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,19}$" },
        "singular": { "type": "string" },
        "plural": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "public": { "type": "boolean", "default": true },
        "icon": { "type": "string", "description": "dashicons-* for admin menu" },
        "supports": { "type": "array", "items": { "enum": ["title", "editor", "excerpt", "thumbnail", "comments", "revisions", "custom-fields"] } },
        "taxonomies": {
          "type": "object",
          "additionalProperties": { "type": "object", "properties": { "singular": { "type": "string" }, "plural": { "type": "string" }, "hierarchical": { "type": "boolean" } } }
        },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } },
        "capabilities": { "type": "array", "items": { "enum": ["purchasable", "orderable"] }, "uniqueItems": true },
        "perPage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  }
}
