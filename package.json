{
  "name": "wpfasty",
  "description": "WordPress theme generator — Latte + UI8Kit primitives, layout/block/style presets",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "author": "godudy",
  "homepage": "https://github.com/godudy/wpfasty",
  "repository": {
    "type": "git",
    "url": "https://github.com/godudy/wpfasty.git"
  },
  "workspaces": [
    ".workspaces/theme-builder",
    ".workspaces/css-build"
  ],
  "scripts": {
    "ui:primitives": "bun tools/generate-primitives.ts",
    "ui:install": "bash tools/ui-install.sh",
    "theme:build": "bun run --cwd .workspaces/theme-builder build",
    "theme:pack": "bun run --cwd .workspaces/theme-builder pack",
    "theme:new": "bun run --cwd .workspaces/theme-builder new",
    "theme:cache": "rm -rf themes/*/~cache",
    "codegen:verify": "bun run --cwd packages/ui8kit-codegen verify",
    "verify": "bun run ui:primitives && bun run theme:build -- latte && bun run lint:design && bun run css:build && bun run test",
    "test": "bash tools/composer.sh test",
    "phpcs": "bash tools/composer.sh phpcs",
    "composer": "bash tools/composer.sh",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f wordpress",
    "dev:composer": "docker compose --profile tools run --rm composer",
    "dev:wp": "docker compose --profile tools run --rm wpcli",
    "css:build": "bun run --cwd .workspaces/css-build build",
    "lint:design": "bun tools/lint-design.ts",
    "icons": "bun tools/icons.ts",
    "i18n:pot": "for t in latte latte-press latte-folio latte-shop latte-skin; do wp i18n make-pot themes/$t themes/$t/languages/$t.pot --domain=$t --exclude=vendor,~cache,node_modules; done",
    "perf:queries": "wp eval-file tools/perf/queries.php"
  },
  "devDependencies": {
    "@ui8kit/contract": "^0.2.0"
  }
}
