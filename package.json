{
  "name": "wpfasty",
  "description": "WordPress theme generator — Latte + UI8Kit primitives, layout/block/style presets",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "author": "alexy-os",
  "homepage": "https://github.com/alexy-os/wp-fasty",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexy-os/wp-fasty.git"
  },
  "workspaces": [
    ".workspaces/theme-builder",
    ".workspaces/css-build"
  ],
  "scripts": {
    "theme:build": "bun run --cwd .workspaces/theme-builder build",
    "theme:pack": "bun run --cwd .workspaces/theme-builder pack",
    "theme:new": "bun run --cwd .workspaces/theme-builder new",
    "theme:cache": "rm -rf themes/*/~cache",
    "verify": "bun run theme:build -- latte && bun run lint:design && bun run css:build && bun run test",
    "test": "bash tools/composer.sh test",
    "phpcs": "bash tools/composer.sh phpcs",
    "composer": "bash tools/composer.sh",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f wordpress",
    "dev:composer": "docker compose --profile tools run --rm composer",
    "dev:wp": "docker compose --profile tools run --rm wpcli",
    "css:build": "bun run --cwd .workspaces/css-build build",
    "lint:design": "bun tools/lint-design.ts",
    "icons": "bun tools/icons.ts",
    "i18n:pot": "for t in latte latte-press latte-folio latte-shop latte-skin; do wp i18n make-pot themes/$t themes/$t/languages/$t.pot --domain=$t --exclude=vendor,~cache,node_modules; done",
    "perf:queries": "wp eval-file tools/perf/queries.php",
    "manifest:validate": "bun tools/manifest/validate.ts",
    "registry:build": "bun tools/builder/registry-build.ts",
    "builder:previews": "bun tools/builder/previews.ts",
    "builder:page-previews": "bun tools/builder/page-previews.ts",
    "registry:verify": "bun tools/builder/registry-verify.ts",
    "theme:generate": "bun .workspaces/theme-builder/src/cli.ts generate",
    "theme:roundtrip": "bun .workspaces/theme-builder/src/cli.ts roundtrip",
    "theme:package": "bun .workspaces/theme-builder/src/cli.ts package",
    "theme:new-site": "bun .workspaces/theme-builder/src/cli.ts new-site",
    "configure:test": "bun .workspaces/theme-builder/src/configure/selftest.ts",
    "generate:test": "bun .workspaces/theme-builder/src/generate/selftest.ts",
    "parity": "php tools/parity/parity.php",
    "parity:press": "php tools/parity/parity.php press",
    "mcp:server": "bun tools/mcp/server.ts",
    "mcp:smoke": "bun tools/mcp/smoke.ts",
    "configure:form": "bun .workspaces/theme-builder/src/configure/form.ts",
    "gates": "bash tools/qa/ui-gates.sh",
    "tokens:contrast": "bun tools/qa/token-contrast.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@ui8kit/contract": "^0.2.0",
    "ajv": "^8",
    "ajv-formats": "^3",
    "zod": "^4.6.7"
  }
}
