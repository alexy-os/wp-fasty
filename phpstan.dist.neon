# PHPStan — static analysis (Symfony convention: phpstan.dist.neon is committed, phpstan.neon is a local override).
# Run: composer phpstan. Level max, no baseline: fix the type, do not suppress it.

parameters:
    level: max
    phpVersion: 80200
    paths:
        - themes/wp-fasty/classes
        - plugins/wpfasty-builder/src
        - plugins/wpfasty-types/src
    bootstrapFiles:
        - themes/wp-fasty/vendor/autoload.php
    scanFiles:
        - themes/wp-fasty/includes/base-theme.php
        - plugins/wpfasty-builder/sources/ui8kit/latte/php/OrganismExtension.php
        - plugins/wpfasty-builder/sources/ui8kit/twig/php/OrganismExtension.php
    tmpDir: var/cache/phpstan
    treatPhpDocTypesAsCertain: false
